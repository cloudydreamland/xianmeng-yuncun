---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalPlanner from '../../components/LocalPlanner.astro';
import WorkspaceTools from '../../components/WorkspaceTools.astro';
import SyncCenter from '../../components/SyncCenter.astro';
import { comparePlans } from '../../utils/planProgress';

const plans = (await getCollection('plans')).sort((a, b) => comparePlans(a.data, b.data));
const publicActions = plans.flatMap((plan) => plan.data.nextActions.filter((action) => action.status !== '已完成').map((action) => ({ title: action.title, plan: plan.data.title, href: `/world/moon-pool/${plan.data.slug}/`, dueAt: action.dueAt?.toISOString().slice(0, 10) })));
---
<BaseLayout title="工作台" description="七境世界的个人本地工作台，用于安排今日重点、私人任务、阅读收集、草稿和周期回顾。">
  <article class="workspace-page page-shell" data-workspace>
    <header class="workspace-hero"><div><p class="pixel-kicker">个人工作台 · PRIVATE SPACE</p><h1>待办、速记、阅读与回顾</h1><p>这里集中显示今天的安排、临时记录、阅读清单和生活工具。</p></div><aside class="workspace-privacy pixel-frame"><strong>数据范围</strong><span>默认保存在本机；启用加密同步后，数据只在持有同步密码的设备上解密。</span></aside></header>
    <nav class="workspace-jump" aria-label="工作台快速目录">
      <a href="#workspace-today"><small>01</small><strong>今日</strong></a>
      <a href="#workspace-reading"><small>02</small><strong>待阅</strong></a>
      <a href="#capture"><small>03</small><strong>速记</strong></a>
      <a href="#workspace-review"><small>04</small><strong>回望</strong></a>
      <a href="#workspace-backup"><small>05</small><strong>备份</strong></a>
      <a href="#workspace-sync"><small>06</small><strong>同步</strong></a>
      <a href="#workspace-tasks"><small>07</small><strong>私务</strong></a>
    </nav>
    <WorkspaceTools publicActions={publicActions} />
    <SyncCenter />
    <section class="workspace-tasks" id="workspace-tasks" aria-labelledby="workspace-tasks-title"><div class="workspace-section-heading"><p class="pixel-kicker">PRIVATE TASKS · 私务簿</p><h2 id="workspace-tasks-title">案上私务</h2><p>细务仍封存于本机；今日云笺会自动拣出七日之内将至的事项。</p></div><LocalPlanner /></section>
  </article>
</BaseLayout>
<style>
  .workspace-page { padding:104px 0 110px; color:var(--world-text); }
  .workspace-hero { display:flex; justify-content:space-between; gap:32px; align-items:end; margin-bottom:34px; padding:34px; border:2px solid #59a7b8; background:rgba(245,253,255,.94); box-shadow:0 8px 0 rgba(47,142,158,.17),inset 0 0 0 2px rgba(255,255,255,.72),0 18px 48px rgba(46,171,194,.16); clip-path:polygon(0 0,calc(100% - 14px) 0,calc(100% - 14px) 6px,calc(100% - 7px) 6px,calc(100% - 7px) 13px,100% 13px,100% 100%,0 100%); }
  .workspace-hero h1,.workspace-section-heading h2 { margin:0; color:#315b66; font-family:var(--serif); }
  .workspace-hero h1 { max-width:760px; font-size:clamp(2.6rem,6vw,5.2rem); line-height:1.04; }
  .workspace-hero p:not(.pixel-kicker) { max-width:680px; color:#58655e; line-height:1.8; }
  .workspace-privacy { display:grid; gap:8px; width:min(280px,100%); padding:18px; color:#376b70; background:#edfafa; }
  .workspace-privacy span { color:#56645c; font-size:.78rem; line-height:1.7; }
  .workspace-jump { position:sticky; z-index:72; top:12px; display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:4px; margin:0 0 28px; padding:7px; border:3px solid #4f6c72; background:rgba(242,251,248,.96); box-shadow:5px 5px 0 rgba(19,45,52,.3); backdrop-filter:blur(12px); }
  .workspace-jump a { display:flex; min-height:44px; align-items:center; justify-content:center; gap:7px; padding:6px 8px; border:1px solid transparent; color:#405b59; font-size:.74rem; }
  .workspace-jump a:hover,.workspace-jump a:focus-visible { border-color:#668483; color:#294f50; background:#dceee6; outline:0; }
  .workspace-jump small { color:#4e7a79; font-size:.58rem; font-weight:900; }
  .workspace-jump strong { font-weight:900; }
  :global(#workspace-today),:global(#workspace-reading),:global(#capture),:global(#workspace-review),:global(#workspace-backup),:global(#workspace-sync),#workspace-tasks { scroll-margin-top:86px; }
  .workspace-tasks { margin-top:62px; }
  .workspace-tasks > .workspace-section-heading .pixel-kicker { color:#b9f0ef; text-shadow:0 2px 12px rgba(5,24,48,.9); }
  .workspace-tasks > .workspace-section-heading h2 { color:#f2ffff; text-shadow:0 2px 14px rgba(5,24,48,.92); }
  .workspace-tasks > .workspace-section-heading > p:last-child { color:#d2eeee; text-shadow:0 2px 10px rgba(5,24,48,.88); }
  .workspace-section-heading { margin-bottom:18px; }
  .workspace-section-heading h2 { font-size:2rem; }
  .workspace-section-heading > p:last-child { color:#56645d; line-height:1.7; }
  .workspace-page .pixel-kicker { color:#24686a; }
  @media (max-width:800px) { .workspace-page { padding:92px 0 80px; } .workspace-hero { display:grid; align-items:start; padding:24px 20px; } .workspace-privacy { width:auto; } .workspace-jump { position:static; grid-template-columns:repeat(4,minmax(0,1fr)); } .workspace-jump a { min-width:0; flex-direction:column; gap:0; } }
</style>
