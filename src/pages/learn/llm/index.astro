---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { llmCurriculum } from '../../../data/llmCurriculum';
import { noteHeadings, sortLlmLearningChapters } from '../../../utils/llmLearning';
import { questionHeadings } from '../../../utils/interview';
import { lessonHeadings } from '../../../utils/pytorchTutorial';

const chapters = sortLlmLearningChapters(await getCollection('llmLearning', ({ data }) => !data.draft));
const chapterCards = await Promise.all(chapters.map(async (chapter) => ({ chapter, notes: noteHeadings((await render(chapter)).headings) })));
const [interviewChapters, practiceChapters] = await Promise.all([
  getCollection('llmInterview', ({ data }) => !data.draft),
  getCollection('pytorchTutorial', ({ data }) => !data.draft),
]);
const interviewDetails = await Promise.all(interviewChapters.map(async (entry) => ({ entry, count: questionHeadings((await render(entry)).headings).length })));
const practiceDetails = await Promise.all(practiceChapters.map(async (entry) => ({ entry, count: lessonHeadings((await render(entry)).headings).length })));
const interviewBySlug = new Map(interviewDetails.map((item) => [item.entry.data.slug, item]));
const practiceBySlug = new Map(practiceDetails.map((item) => [item.entry.data.slug, item]));
const chapterBySlug = new Map(chapterCards.map((item) => [item.chapter.data.slug, item]));
const courseModules = llmCurriculum.map((module) => ({
  ...module,
  main: chapterBySlug.get(module.chapterSlug),
  deepDives: module.deepDiveSlugs.map((slug) => interviewBySlug.get(slug)).filter(Boolean),
  practices: module.practiceSlugs.map((slug) => practiceBySlug.get(slug)).filter(Boolean),
}));
const notes = chapterCards.flatMap(({ chapter, notes }) => notes.map((note) => ({
  title: note.text,
  href: `/learn/llm/${chapter.data.slug}/#${note.slug}`,
  chapter: chapter.data.title,
  stage: chapter.data.stage,
  topics: chapter.data.topics.join(' '),
})));
const interviewQuestions = interviewDetails.reduce((sum, item) => sum + item.count, 0);
const practiceLessons = practiceDetails.reduce((sum, item) => sum + item.count, 0);
const bodyLength = (entry: { body?: string }) => entry.body?.length ?? 0;
const totalCourseChars = [...chapters, ...interviewChapters, ...practiceChapters].reduce((sum, entry) => sum + bodyLength(entry), 0);
const courseScale = Math.floor(totalCourseChars / 43204);
const phases = ['基础建模', '训练方法', '系统工程', '综合应用'] as const;
---

<BaseLayout title="大模型从零学习笔记" description="面向零基础读者的逐章大模型完整笔记，从 Token 和神经网络直觉走到 Transformer、训练、对齐、推理、RAG、Agent 与评测。" searchable searchType="教程" searchTitle="大模型从零学习笔记" searchCategory="大模型系统笔记" searchTags={['大模型', '零基础', 'Transformer', '系统学习']}>
  <main class="llm-notes-home page-shell">
    <nav class="llm-notes-home__breadcrumb" aria-label="面包屑"><a href="/world/rain-bridge/">雨桥</a><span>/</span><span aria-current="page">大模型系统笔记</span></nav>
    <header class="llm-notes-home__hero">
      <div><p class="pixel-kicker">由浅入深的完整课程</p><h1>大模型从零学习笔记</h1><p>13 章主教材串起知识骨架，并按章节配有 150 个原理专题和 74 个代码实验。学习顺序从基础概念、机制推导和动手实现，逐步走到系统设计与综合项目。</p><div class="llm-notes-home__actions"><a href={`/learn/llm/${chapters[0]?.data.slug}/`}>从第一章开始</a><a href="#full-course">查看完整课程</a></div></div>
      <dl><div><dt>{chapters.length}</dt><dd>主教材章节</dd></div><div><dt>{interviewQuestions}</dt><dd>原理专题</dd></div><div><dt>{practiceLessons}</dt><dd>代码实验</dd></div><div><dt>{courseScale}×+</dt><dd>课程正文</dd></div></dl>
    </header>

    <section class="llm-notes-progress" data-pagefind-ignore>
      <div><p class="pixel-kicker">阅读记录</p><h2>本机学习进度</h2><p data-llm-learning-progress-text>尚无已完成的小节。</p></div>
      <div class="llm-notes-progress__meter"><span data-llm-learning-progress-meter style="--progress:0%"></span></div>
      <div><a href={`/learn/llm/${chapters[0]?.data.slug}/`} data-llm-learning-continue>开始第一章</a><button type="button" data-llm-learning-reset>重置本机进度</button></div>
      <small>学习记录只保存在当前设备，不会上传。</small>
    </section>

    <section class="llm-notes-guide">
      <div><p class="pixel-kicker">学习方法</p><h2>每个主题分四层学习</h2><p>各章依次安排主教材、原理专题、代码实践和掌握检查。</p></div>
      <ol><li><span>01</span><strong>主教材</strong><p>通过路线图、数据流和例子梳理知识结构。</p></li><li><span>02</span><strong>原理深挖</strong><p>补充公式推导、边界条件、追问和常见误区。</p></li><li><span>03</span><strong>代码实践</strong><p>从张量与训练循环走到 Transformer、分布式和综合项目。</p></li><li><span>04</span><strong>掌握检查</strong><p>通过闭卷复述、故障定位和设计题检查掌握情况。</p></li></ol>
    </section>

    <section class="llm-course-roadmap" id="full-course">
      <header><p class="pixel-kicker">完整课程表</p><h2>四阶段课程路线</h2><p>每个模块列出主教材、原理专题、代码实践和掌握标准，内容已按知识依赖排好顺序。</p></header>
      {phases.map((phase, phaseIndex) => <section aria-labelledby={`phase-${phaseIndex + 1}`}><div class="llm-course-roadmap__phase"><span>阶段 {phaseIndex + 1}</span><h3 id={`phase-${phaseIndex + 1}`}>{phase}</h3></div><div class="llm-course-roadmap__modules">{courseModules.filter((module) => module.phase === phase).map((module) => module.main && <article>
        <header><span>{String(module.main.chapter.data.order).padStart(2, '0')}</span><div><small>{module.main.notes.length} 节主教材 · {module.main.chapter.data.estimatedMinutes} 分钟</small><h4>{module.main.chapter.data.title}</h4></div></header>
        <ol><li><b>1</b><div><strong>理解主线</strong><a href={`/learn/llm/${module.main.chapter.data.slug}/`}>进入本章主教材 →</a></div></li><li><b>2</b><div><strong>原理深挖</strong>{module.deepDives.map((item) => item && <a href={`/interview/llm/${item.entry.data.slug}/`}>{item.entry.data.title}（{item.count} 题）</a>)}</div></li><li><b>3</b><div><strong>代码实践</strong>{module.practices.length ? module.practices.map((item) => item && <a href={`/learn/pytorch/${item.entry.data.slug}/`}>{item.entry.data.title}（{item.count} 节）</a>) : <span>{module.studyOrder[2]}</span>}</div></li></ol>
        <p><strong>学会的标准：</strong>{module.mastery}</p>
      </article>)}</div></section>)}
    </section>

    <section class="llm-notes-finder" data-pagefind-ignore>
      <div><p class="pixel-kicker">笔记索引</p><h2>搜索知识点</h2></div>
      <label><span aria-hidden="true">⌕</span><input type="search" placeholder="例如：Token、注意力、LoRA、KV Cache、RAG" aria-label={`搜索${notes.length}节大模型学习笔记`} data-llm-learning-search /></label>
      <p data-llm-learning-search-status aria-live="polite">支持按知识点、章节和阶段搜索。</p>
      <div data-llm-learning-results hidden>{notes.map((note) => <a href={note.href} data-search-text={`${note.title} ${note.chapter} ${note.stage} ${note.topics}`.toLowerCase()}><small>{note.stage} · {note.chapter}</small><strong>{note.title}</strong></a>)}</div>
    </section>

    <section class="llm-notes-map" id="chapter-map">
      <header><p class="pixel-kicker">主教材速查</p><h2>从模型基础到完整项目</h2><p>主教材负责串起知识骨架；每章底部会继续带你进入本章对应的推导专题与实践课。</p></header>
      <div>{chapterCards.map(({ chapter, notes }) => <a href={`/learn/llm/${chapter.data.slug}/`}><span>{String(chapter.data.order).padStart(2, '0')}</span><small>{chapter.data.stage} · {notes.length} 节 · {chapter.data.estimatedMinutes} 分钟</small><h3>{chapter.data.title}</h3><p>{chapter.data.description}</p><em>{chapter.data.topics.slice(0, 3).join(' / ')}</em><strong>进入本章 →</strong></a>)}</div>
    </section>

    <section class="llm-notes-switch"><div><p class="pixel-kicker">课程内容</p><h2>约 {Math.round(totalCourseChars / 10000)} 万字正文</h2><p>包含 {notes.length} 节主教材、{interviewQuestions} 个原理专题和 {practiceLessons} 个代码实验。</p></div><a href={`/learn/llm/${chapters[0]?.data.slug}/`}>开始第一阶段 →</a></section>
  </main>

  <script is:inline define:vars={{ totalNotes: notes.length }}>
    const progressKey = 'xianmeng:llm-learning-progress:v1';
    const lastKey = 'xianmeng:llm-learning-last-read:v1';
    const text = document.querySelector('[data-llm-learning-progress-text]');
    const meter = document.querySelector('[data-llm-learning-progress-meter]');
    const continueLink = document.querySelector('[data-llm-learning-continue]');
    const reset = document.querySelector('[data-llm-learning-reset]');
    const renderProgress = () => {
      let completed = [];
      let last = null;
      try { completed = JSON.parse(localStorage.getItem(progressKey) || '[]'); last = JSON.parse(localStorage.getItem(lastKey) || 'null'); } catch {}
      const count = completed.length;
      if (text) text.textContent = count ? `已完成 ${count} / ${totalNotes} 节。` : '尚无已完成的小节。';
      if (meter) meter.style.setProperty('--progress', `${Math.min(100, Math.round(count / totalNotes * 100))}%`);
      if (continueLink && last?.href) { continueLink.href = last.href; continueLink.textContent = `继续：${last.title}`; }
    };
    reset?.addEventListener('click', () => { localStorage.removeItem(progressKey); localStorage.removeItem(lastKey); location.reload(); });
    renderProgress();
    const input = document.querySelector('[data-llm-learning-search]');
    const results = document.querySelector('[data-llm-learning-results]');
    const status = document.querySelector('[data-llm-learning-search-status]');
    const items = [...(results?.querySelectorAll('a') || [])];
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      if (!results || !status) return;
      if (!query) { results.hidden = true; items.forEach((item) => { item.hidden = false; }); status.textContent = '支持按知识点、章节和阶段搜索。'; return; }
      let count = 0;
      items.forEach((item) => { const match = item.dataset.searchText?.includes(query); item.hidden = !match; if (match) count += 1; });
      results.hidden = false; status.textContent = count ? `找到 ${count} 节相关笔记` : '没有匹配内容，试试更短的关键词。';
    });
  </script>
</BaseLayout>

<style>
