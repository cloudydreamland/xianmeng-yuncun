ign-items:start}.llm-course-roadmap__modules article>header>span{color:rgba(65,94,126,.35);font-family:var(--serif);font-size:1.8rem;font-weight:900}.llm-course-roadmap__modules h4{margin:3px 0 0;color:#3d5875;font-family:var(--serif);font-size:1.18rem}.llm-course-roadmap__modules small{color:#748493;font-size:.62rem}.llm-course-roadmap__modules ol{display:grid;gap:6px;margin:0;padding:0;list-style:none}.llm-course-roadmap__modules li{display:grid;grid-template-columns:25px 1fr;gap:8px;padding:9px;border-left:2px solid #718ba5;background:#eef3f6}.llm-course-roadmap__modules li b{color:#6b8195}.llm-course-roadmap__modules li div{display:grid;gap:3px}.llm-course-roadmap__modules li strong{color:#4a6379;font-size:.7rem}.llm-course-roadmap__modules li a,.llm-course-roadmap__modules li span{color:#5f7580;font-size:.68rem;line-height:1.55}.llm-course-roadmap__modules li a{color:#356d85}.llm-course-roadmap__modules article>p{margin:0;padding:11px;border-radius:10px;color:#60756d;background:#edf5ea;font-size:.7rem;line-height:1.65}.llm-notes-finder{margin-bottom:64px;padding:26px 30px;border:1px solid #8296a8;border-radius:27px;background:rgba(255,253,246,.92)}.llm-notes-finder label{display:flex;align-items:center;gap:9px;margin-top:15px;padding:0 15px;border:2px solid #647f9d;border-radius:14px;background:#fff}.llm-notes-finder input{width:100%;min-height:48px;border:0;outline:0;background:transparent}.llm-notes-finder>p{color:#75818a;font-size:.72rem}.llm-notes-finder>[data-llm-learning-results]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-height:400px;overflow:auto}.llm-notes-finder>[data-llm-learning-results][hidden]{display:none}.llm-notes-finder [data-llm-learning-results] a{display:grid;gap:3px;padding:12px;border-left:3px solid #5c7fa1;color:#4e687d;background:#edf3f6}.llm-notes-finder [data-llm-learning-results] a[hidden]{display:none}.llm-notes-finder small{color:#74818b;font-size:.62rem}.llm-notes-map>header{max-width:780px;margin-bottom:28px}.llm-notes-map>header>p:last-child{color:#6e7b82;line-height:1.8}.llm-notes-map>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.llm-notes-map>div>a{position:relative;display:flex;min-height:275px;flex-direction:column;overflow:hidden;padding:27px;border:1px solid rgba(72,93,118,.2);border-radius:27px;color:#536b79;background:rgba(255,253,246,.9);box-shadow:var(--shadow-soft)}.llm-notes-map>a:hover{transform:translateY(-2px)}.llm-notes-map a>span{position:absolute;right:17px;top:4px;color:rgba(68,99,131,.12);font-family:var(--serif);font-size:5rem;font-weight:900}.llm-notes-map a small{color:#66809a;font-size:.65rem}.llm-notes-map h3{position:relative;margin:18px 0 8px;color:#3d5874;font-family:var(--serif);font-size:1.5rem}.llm-notes-map h3+p{position:relative;flex:1;color:#718087;font-size:.8rem;line-height:1.75}.llm-notes-map em{color:#758d9c;font-size:.68rem;font-style:normal}.llm-notes-map a strong{margin-top:12px;color:#3e6e8d;font-size:.74rem}.llm-notes-switch{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-top:30px;padding:32px;border:1px solid #8a9b8d;border-radius:27px;background:#eef4e5}.llm-notes-switch p:last-child{max-width:700px;color:#6f7c75;line-height:1.75}.llm-notes-switch>a{flex:none;min-height:46px;padding:12px 17px;border-radius:13px;color:#fff;background:#4c735f;font-weight:900}@media(max-width:900px){.llm-notes-home__hero{grid-template-columns:1fr}.llm-notes-home__hero dl{display:flex;flex-wrap:wrap}.llm-notes-guide{grid-template-columns:1fr}.llm-notes-switch{align-items:start;flex-direction:column}}@media(max-width:640px){.llm-notes-home{padding-top:105px}.llm-notes-home__hero{border-radius:26px}.llm-notes-home__hero dl div{flex:1;min-width:85px}.llm-notes-guide li{grid-template-columns:32px 1fr}.llm-notes-guide li p{grid-column:2}.llm-course-roadmap__modules,.llm-notes-finder>[data-llm-learning-results],.llm-notes-map>div{grid-template-columns:1fr}.llm-notes-progress,.llm-notes-finder{padding:23px 19px}.llm-notes-switch{padding:24px 20px}}
</style>
