  @media(max-width:850px){.course-home__header,.course-compass,.course-projects{grid-template-columns:1fr;align-items:start}.course-home__header dl{flex-wrap:wrap}.course-home__header dl div{flex:1;min-width:90px}.course-map>div{grid-template-columns:1fr}.course-verification dl{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.course-home{padding-top:105px}.course-home__header{border-radius:26px}.course-home__header dl{width:100%}.course-home__header dl div:last-child{flex-basis:100%}.course-dashboard{grid-template-columns:1fr;padding:22px 18px}.course-compass{padding:24px 20px}.course-compass ol,.course-finder__results{grid-template-columns:1fr}.course-map a{min-height:250px;padding:24px}.course-projects,.course-verification,.course-sources{padding:24px 20px;border-radius:24px}}
</style>
