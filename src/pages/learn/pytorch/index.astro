  .course-compass{display:grid;grid-template-columns:.55fr 1.45fr;gap:36px;margin:28px 0 30px;padding:30px;border:1px solid #90a0b1;border-radius:28px;background:rgba(255,253,246,.92)}.course-compass h2,.course-map h2,.course-projects h2,.course-sources h2{margin:7px 0 12px;color:#3f5873;font-family:var(--serif);font-size:clamp(1.8rem,4vw,2.7rem)}.course-compass ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0;padding:0;list-style:none}.course-compass li{position:relative;padding:17px 18px 16px 48px;border-radius:18px;background:#edf3f8}.course-compass li>span{position:absolute;left:15px;top:17px;color:#6382a2;font-size:.7rem}.course-compass strong{color:#405e7a}.course-compass li p{margin:5px 0 0;color:#718087;font-size:.75rem;line-height:1.65}
  .course-dashboard{display:grid;grid-template-columns:1fr auto;gap:10px 30px;align-items:center;margin:28px 0;padding:26px 30px;border:1px solid #8299b0;border-radius:26px;background:#fffdf5}.course-dashboard h2{margin:5px 0;color:#405d7b;font-family:var(--serif)}.course-dashboard p{margin:4px 0;color:#6e7c84;font-size:.76rem}.course-dashboard__meter{grid-column:1/-1;height:10px;overflow:hidden;border-radius:999px;background:#dde5eb}.course-dashboard__meter span{display:block;width:var(--course-percent);height:100%;background:linear-gradient(90deg,#567ba5,#64a193);transition:width .3s}.course-dashboard__actions{display:flex;flex-wrap:wrap;gap:8px}.course-dashboard__actions a,.course-dashboard__actions button{min-height:44px;padding:10px 14px;border:1px solid #5e7d9e;border-radius:999px;color:#fff;background:#52749b;cursor:pointer;font:inherit;font-size:.7rem;font-weight:900}.course-dashboard__actions button{color:#526b82;background:transparent}.course-dashboard>small{color:#78838a;font-size:.64rem}
  .course-finder{margin:0 0 74px;padding:26px clamp(20px,4vw,34px);border:1px solid #8597a8;border-radius:28px;background:rgba(255,253,246,.92)}.course-finder>div:first-child{display:flex;align-items:baseline;gap:15px}.course-finder h2{margin:0;color:#435e79;font-family:var(--serif)}.course-finder label{display:flex;align-items:center;gap:10px;margin-top:18px;padding:0 16px;border:2px solid #5c7b9d;border-radius:16px;background:#fffdf5}.course-finder input{width:100%;min-height:50px;border:0;outline:0;color:#405764;background:transparent;font:inherit}.course-finder>p{color:#708087;font-size:.72rem}.course-finder__results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-height:420px;overflow:auto;margin-top:14px}.course-finder__results a{display:grid;gap:3px;padding:12px 14px;border-left:3px solid #6682a1;color:#526673;background:#eef3f7}.course-finder__results a[hidden]{display:none}.course-finder__results small{color:#71808d;font-size:.62rem}
  .course-map{scroll-margin-top:24px}.course-map>header{max-width:760px;margin-bottom:30px}.course-map header>p:last-child{color:#6c7a81;line-height:1.8}.course-map>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.course-map a{position:relative;min-height:280px;overflow:hidden;padding:28px;border:1px solid rgba(77,95,127,.2);border-radius:28px;color:#536571;background:rgba(255,253,246,.9);box-shadow:var(--shadow-soft);transition:transform .2s ease,border-color .2s ease}.course-map a:hover{border-color:#718aa8;transform:translateY(-3px)}.course-map a>span{position:absolute;right:20px;top:8px;color:rgba(74,100,135,.12);font-family:var(--serif);font-size:5rem;font-weight:900}.course-map a small{color:#648096;font-size:.65rem}.course-map h3{position:relative;margin:18px 0 10px;color:#3e5873;font-family:var(--serif);font-size:1.5rem}.course-map a p{position:relative;min-height:4.8em;color:#718087;font-size:.82rem;line-height:1.75}.course-map a em{display:block;margin-bottom:13px;color:#80694d;font-size:.64rem;font-style:normal}.course-map a strong{color:#3c6d91;font-size:.75rem}
