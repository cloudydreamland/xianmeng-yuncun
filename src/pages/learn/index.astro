---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { noteHeadings, sortLlmLearningChapters } from '../../utils/llmLearning';
import { lessonHeadings, sortPytorchChapters } from '../../utils/pytorchTutorial';
import { questionHeadings, sortInterviewChapters } from '../../utils/interview';

const llmChapters = sortLlmLearningChapters(await getCollection('llmLearning', ({ data }) => !data.draft));
const pytorchChapters = sortPytorchChapters(await getCollection('pytorchTutorial', ({ data }) => !data.draft));
const interviewChapters = sortInterviewChapters(await getCollection('llmInterview', ({ data }) => !data.draft));
const llmSections = (await Promise.all(llmChapters.map(async (item) => noteHeadings((await render(item)).headings)))).flat().length;
const pytorchLessons = (await Promise.all(pytorchChapters.map(async (item) => lessonHeadings((await render(item)).headings)))).flat().length;
const interviewQuestions = (await Promise.all(interviewChapters.map(async (item) => questionHeadings((await render(item)).headings)))).flat().length;
---

<BaseLayout title="学习中心｜从零学大模型" description="把大模型系统笔记、PyTorch 实践课和面试问答整理成三条清晰学习路径。">
  <main class="learn-hub page-shell">
    <nav aria-label="面包屑"><a href="/world/star-abyss/">星渊</a><span>/</span><span aria-current="page">学习中心</span></nav>
    <header class="learn-hub__hero">
      <p class="pixel-kicker">大模型学习资料</p>
      <h1>从零学大模型</h1>
      <p>系统笔记讲概念和原理，PyTorch 课程提供代码实践，问道录收录面试问题。三套内容相互关联，也可以单独使用。</p>
    </header>

    <section class="learn-paths" aria-labelledby="learn-paths-title">
      <header><p class="pixel-kicker">内容分类</p><h2 id="learn-paths-title">三套学习内容</h2></header>
      <div>
        <article class="learn-path learn-path--primary">
          <span>系统笔记</span><p>01 · 概念与原理</p><h3>大模型从零学习笔记</h3>
          <p>用直白解释、例子和章节小结，逐步看懂 Token、Transformer、训练、微调、推理、RAG 与 Agent。</p>
          <dl><div><dt>{llmChapters.length}</dt><dd>章</dd></div><div><dt>{llmSections}</dt><dd>节笔记</dd></div></dl>
          <a href="/learn/llm/">开始系统学习 →</a>
        </article>
        <article class="learn-path">
          <span>代码实践</span><p>02 · PyTorch 工程</p><h3>PyTorch 工程实践课</h3>
          <p>从 Tensor 和自动求导开始，亲手写训练循环、Transformer、分布式训练与迷你语言模型。</p>
          <dl><div><dt>{pytorchChapters.length}</dt><dd>章</dd></div><div><dt>{pytorchLessons}</dt><dd>节课程</dd></div></dl>
          <a href="/learn/pytorch/">进入实践课程 →</a>
        </article>
        <article class="learn-path">
          <span>面试题库</span><p>03 · 问题与答案</p><h3>大模型面经 · 问道录</h3>
          <p>共 14 章、150 道题，每题包含简答、原理、追问与常见误区。</p>
          <dl><div><dt>{interviewChapters.length}</dt><dd>章</dd></div><div><dt>{interviewQuestions}</dt><dd>道题</dd></div></dl>
          <a href="/interview/llm/">进入面试题库 →</a>
        </article>
      </div>
    </section>

    <section class="learn-order">
      <p class="pixel-kicker">内容关系</p><h2>同一主题的三种视角</h2>
      <ol><li><strong>概念与原理</strong><span>系统笔记梳理术语、机制和上下游关系。</span></li><li><strong>代码与实验</strong><span>PyTorch 课程展示张量形状、训练过程和工程实现。</span></li><li><strong>问题与表达</strong><span>面试题库汇总常见问题、追问和回答要点。</span></li></ol>
    </section>
  </main>
</BaseLayout>

<style>
  .learn-hub{padding:128px 0 110px}.learn-hub>nav{display:flex;gap:8px;margin-bottom:22px;color:var(--ink-soft);font-size:.72rem}.learn-hub>nav a{color:#456da0}.learn-hub__hero{padding:clamp(34px,7vw,72px);border:1px solid rgba(66,89,130,.22);border-radius:38px;background:linear-gradient(140deg,rgba(235,243,255,.97),rgba(235,248,236,.95));box-shadow:var(--shadow-soft)}.learn-hub__hero h1{margin:10px 0 16px;color:#354f75;font-family:var(--serif);font-size:clamp(2.8rem,8vw,5.6rem);line-height:1.15}.learn-hub__hero>p:last-child{max-width:760px;margin:0;color:#62727b;line-height:1.9}.learn-paths{margin-top:72px}.learn-paths>header{margin-bottom:25px}.learn-paths h2,.learn-order h2{margin:7px 0;color:#405a76;font-family:var(--serif);font-size:clamp(1.9rem,4vw,2.8rem)}.learn-paths>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.learn-path{display:flex;min-height:390px;flex-direction:column;padding:27px;border:1px solid rgba(75,94,119,.2);border-radius:28px;background:rgba(255,253,246,.92);box-shadow:var(--shadow-soft)}.learn-path--primary{border:2px solid #5d7fa8;background:linear-gradient(155deg,#f4f7ff,#f3f7e8)}.learn-path>span{align-self:flex-start;padding:5px 9px;border-radius:999px;color:#fff;background:#607da0;font-size:.62rem}.learn-path>p:first-of-type{margin:22px 0 7px;color:#718293;font-size:.68rem;font-weight:900;letter-spacing:.12em}.learn-path h3{margin:0;color:#3f5873;font-family:var(--serif);font-size:1.55rem}.learn-path h3+p{flex:1;color:#6b7980;font-size:.8rem;line-height:1.8}.learn-path dl{display:flex;gap:18px;margin:18px 0}.learn-path dl div{display:flex;align-items:baseline;gap:4px}.learn-path dt{color:#476d95;font-family:var(--serif);font-size:1.45rem;font-weight:900}.learn-path dd{margin:0;color:#77838a;font-size:.66rem}.learn-path>a{min-height:46px;padding:12px 15px;border-radius:13px;color:#fff;background:#4f7096;text-align:center;font-weight:900}.learn-order{margin-top:28px;padding:36px;border:1px solid #8c9b8b;border-radius:28px;background:#eef3e5}.learn-order ol{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:25px 0 0;padding:0;list-style:none}.learn-order li{display:grid;gap:6px;padding:17px;border-left:4px solid #67889b;background:#fffdf5}.learn-order li strong{color:#446276}.learn-order li span{color:#758079;font-size:.74rem;line-height:1.65}@media(max-width:880px){.learn-paths>div{grid-template-columns:1fr}.learn-path{min-height:0}.learn-order ol{grid-template-columns:1fr}}@media(max-width:600px){.learn-hub{padding-top:105px}.learn-hub__hero{border-radius:26px}.learn-order{padding:24px 20px}}
</style>
