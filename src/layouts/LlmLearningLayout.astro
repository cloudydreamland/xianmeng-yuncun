---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import type { LlmLearningChapter } from '../utils/llmLearning';
import { llmLearningGlossary } from '../data/llmLearningGlossary';

interface Heading { depth: number; slug: string; text: string; }
interface Props { chapter: LlmLearningChapter; chapters: LlmLearningChapter[]; notes: Heading[]; prev?: LlmLearningChapter; next?: LlmLearningChapter; }
const { chapter, chapters, notes, prev, next } = Astro.props;
const glossary = llmLearningGlossary[chapter.data.slug] ?? [];
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<BaseLayout title={`${chapter.data.title}｜大模型从零学习笔记`} description={chapter.data.description} searchable searchType="教程" searchTitle={chapter.data.title} searchCategory="大模型系统笔记" searchTags={chapter.data.topics} searchDate={chapter.data.updatedAt}>
  <div class="study-reading-progress" aria-hidden="true"><span data-study-reading-progress></span></div>
  <main class="study-page page-shell">
    <nav class="study-breadcrumb" aria-label="面包屑"><a href="/learn/">学习中心</a><span>/</span><a href="/learn/llm/">大模型系统笔记</a><span>/</span><span aria-current="page">{chapter.data.title}</span></nav>
    <div class="study-mode-switch" data-pagefind-ignore><span>系统笔记</span><a href={chapter.data.interviewHref}>对应面试题 →</a></div>

    <details class="study-mobile-directory" data-pagefind-ignore>
      <summary>展开全套章节与本章目录 <span aria-hidden="true">⌄</span></summary>
      <div><strong>{chapters.length} 章学习路线</strong>{chapters.map((item) => <a href={`/learn/llm/${item.data.slug}/`} aria-current={item.id === chapter.id ? 'page' : undefined}><small>{String(item.data.order).padStart(2, '0')}</small><span>{item.data.title}</span></a>)}<strong>本章 {notes.length} 节</strong>{notes.map((note, index) => <a href={`#${note.slug}`} data-study-note-link={note.slug}><small>{String(index + 1).padStart(2, '0')}</small><span>{note.text}</span></a>)}</div>
    </details>

    <div class="study-grid">
      <aside class="study-directory" aria-label="大模型系统笔记目录" data-pagefind-ignore>
        <a class="study-directory__home" href="/learn/llm/">大模型系统笔记</a>
        <div class="study-directory__scroll"><p>{chapters.length} 章路线</p><nav>{chapters.map((item) => <a href={`/learn/llm/${item.data.slug}/`} aria-current={item.id === chapter.id ? 'page' : undefined}><small>{String(item.data.order).padStart(2, '0')}</small><span>{item.data.title}</span></a>)}</nav><p>本章 {notes.length} 节</p><nav class="study-directory__notes">{notes.map((note, index) => <a href={`#${note.slug}`} data-study-note-link={note.slug}><small>{String(index + 1).padStart(2, '0')}</small><span>{note.text}</span></a>)}</nav></div>
      </aside>

      <article class="study-article">
        <header class="study-article__header">
          <p class="pixel-kicker">第 {String(chapter.data.order).padStart(2, '0')} 章 · {chapter.data.stage}</p><h1>{chapter.data.title}</h1><p>{chapter.data.description}</p>
          <div class="study-article__facts"><span>{notes.length} 节笔记</span><span>预计 {chapter.data.estimatedMinutes} 分钟</span><span>校订于 {formatDate(chapter.data.updatedAt)}</span></div>
          <dl><div><dt>开始前</dt><dd>{chapter.data.prerequisites.length ? chapter.data.prerequisites.join(' · ') : '无需前置知识'}</dd></div><div><dt>学完后</dt><dd>{chapter.data.outcomes.join(' · ')}</dd></div></dl>
          <div class="study-tags">{chapter.data.topics.map((topic) => <span>{topic}</span>)}</div>
        </header>

        <div class="study-prose"><slot /></div>

        {glossary.length > 0 && <section class="study-glossary" aria-labelledby="study-glossary-title"><p class="pixel-kicker">本章术语</p><h2 id="study-glossary-title">六个关键词</h2><dl>{glossary.map((item) => <div><dt>{item.term}</dt><dd>{item.definition}</dd></div>)}</dl></section>}

        <section class="study-finish" data-pagefind-ignore><p class="pixel-kicker">章节记录</p><h2>本章完成情况</h2><div><label><input type="checkbox" data-study-chapter-check /> 已读完并能概括本章主线</label><a href={chapter.data.interviewHref}><strong>对应面试题</strong><span>查看同主题的问题与答案 →</span></a></div></section>
        <nav class="study-chapter-nav" aria-label="相邻章节" data-pagefind-ignore>{prev ? <a href={`/learn/llm/${prev.data.slug}/`}><small>← 上一章</small><strong>{prev.data.title}</strong></a> : <span></span>}{next ? <a href={`/learn/llm/${next.data.slug}/`}><small>下一章 →</small><strong>{next.data.title}</strong></a> : <a href="/learn/llm/"><small>完成路线</small><strong>返回章节地图</strong></a>}</nav>
      </article>
    </div>
  </main>

  <script>
    const prose = document.querySelector<HTMLElement>('.study-prose');
    const progress = document.querySelector<HTMLElement>('[data-study-reading-progress]');
    const headings = [...document.querySelectorAll<HTMLElement>('.study-prose h2[id]')];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-study-note-link]')];
    const chapterSlug = location.pathname.split('/').filter(Boolean).at(-1) || '';
    const progressKey = 'xianmeng:llm-learning-progress:v1';
    const lastKey = 'xianmeng:llm-learning-last-read:v1';
    let completed = new Set<string>();
    try { completed = new Set<string>(JSON.parse(localStorage.getItem(progressKey) || '[]')); } catch {}
    const noteKey = (id: string) => `${chapterSlug}#${id}`;
    headings.forEach((heading) => {
      const button = document.createElement('button'); button.type = 'button'; button.className = 'study-note-toggle';
      const render = () => { const done = completed.has(noteKey(heading.id)); button.setAttribute('aria-pressed', String(done)); button.textContent = done ? '✓ 已学完' : '○ 标记学完'; };
      button.addEventListener('click', () => { const key = noteKey(heading.id); if (completed.has(key)) completed.delete(key); else completed.add(key); localStorage.setItem(progressKey, JSON.stringify([...completed])); render(); });
      heading.insertAdjacentElement('afterend', button); render();
    });
    const updateActive = () => {
      let active = headings[0]?.id; for (const heading of headings) if (heading.getBoundingClientRect().top <= 150) active = heading.id;
      links.forEach((link) => { const current = link.dataset.studyNoteLink === active; link.classList.toggle('active', current); if (current) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); });
      if (active) { const title = headings.find((item) => item.id === active)?.textContent || document.title; try { localStorage.setItem(lastKey, JSON.stringify({ href: `${location.pathname}#${active}`, title, updatedAt: Date.now() })); } catch {} }
    };
    const updateProgress = () => { if (!prose || !progress) return; const distance = Math.max(1, prose.offsetHeight - innerHeight); const value = Math.min(1, Math.max(0, (scrollY - prose.offsetTop) / distance)); progress.style.transform = `scaleX(${value})`; };
    addEventListener('scroll', updateActive, { passive: true }); addEventListener('scroll', updateProgress, { passive: true }); addEventListener('resize', updateProgress, { passive: true }); updateActive(); updateProgress();
  </script>
</BaseLayout>

<style>
  .study-reading-progress{position:fixed;z-index:130;inset:0 0 auto;height:3px;background:rgba(255,255,255,.3);pointer-events:none}.study-reading-progress span{display:block;width:100%;height:100%;background:linear-gradient(90deg,#547bb2,#59a08a,#d69c54);transform:scaleX(0);transform-origin:left}.study-page{padding:118px 0 100px}.study-breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;color:var(--ink-soft);font-size:.72rem}.study-breadcrumb a{color:#426c9b}.study-mode-switch{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px;padding:10px 14px;border:1px solid #8fa1ae;border-radius:13px;color:#61737d;background:rgba(255,253,246,.85);font-size:.7rem}.study-mode-switch a{color:#3f6e91;font-weight:900}.study-grid{display:grid;grid-template-columns:270px minmax(0,820px);gap:42px;align-items:start;justify-content:center}.study-directory{position:sticky;top:24px;max-height:calc(100svh - 48px);overflow:hidden;border:1px solid rgba(72,92,130,.22);border-radius:24px;background:rgba(255,253,246,.94);box-shadow:var(--shadow-soft)}.study-directory__home{display:block;padding:18px 20px;color:#fff;background:#3f5f88;font-family:var(--serif);font-weight:900}.study-directory__scroll{max-height:calc(100svh - 108px);overflow:auto;padding:12px 10px 18px;scrollbar-width:thin}.study-directory p{margin:12px 10px 7px;color:#766451;font-size:.62rem;font-weight:900;letter-spacing:.15em}.study-directory nav{display:grid;gap:2px}.study-directory nav a{display:grid;grid-template-columns:25px 1fr;gap:7px;align-items:start;padding:7px 9px;border-radius:10px;color:#617078;font-size:.7rem;line-height:1.5}.study-directory nav a:hover,.study-directory nav a.active{color:#315b75;background:#e4edf3}.study-directory nav a[aria-current="page"]{color:#fff;background:#506f96}.study-directory nav small{opacity:.68}.study-directory__notes{padding-left:5px;border-left:1px dashed #9caab8}.study-mobile-directory{display:none}.study-article{min-width:0}.study-article__header{margin-bottom:28px;padding:38px clamp(24px,5vw,48px);border:1px solid rgba(76,95,134,.2);border-radius:30px;background:linear-gradient(145deg,rgba(239,245,255,.97),rgba(232,247,241,.94));box-shadow:var(--shadow-soft)}.study-article__header h1{margin:10px 0 12px;color:#344f70;font-family:var(--serif);font-size:clamp(2rem,5vw,3.25rem);line-height:1.3}.study-article__header>p:not(.pixel-kicker){max-width:680px;color:var(--ink-soft);line-height:1.8}.study-article__facts{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:18px;color:#607078;font-size:.72rem}.study-article__header dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:18px 0 0}.study-article__header dl div{padding:11px 13px;border:1px solid rgba(78,105,137,.2);border-radius:12px;background:rgba(255,255,255,.55)}.study-article__header dt{color:#405f7d;font-size:.65rem;font-weight:900}.study-article__header dd{margin:4px 0 0;color:#66757d;font-size:.7rem;line-height:1.55}.study-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:16px}.study-tags span{padding:5px 10px;border:1px solid #8ea4bd;border-radius:999px;color:#49657f;background:#fbf8e6;font-size:.66rem}.study-prose{min-width:0;padding:clamp(26px,5vw,56px);border:1px solid rgba(82,91,117,.14);border-radius:30px;color:#46575e;background:rgba(255,253,246,.95);box-shadow:var(--shadow-soft);font-family:var(--serif);font-size:1rem;line-height:1.95}.study-prose :global(h2){margin:3.2em 0 1em;padding-top:.25em;color:#395875;font-size:1.75rem;line-height:1.45;scroll-margin-top:28px}.study-prose :global(h2:first-child){margin-top:0}.study-prose :global(h2::before){content:"学";display:inline-grid;width:1.75em;height:1.75em;place-items:center;margin-right:.55em;border-radius:8px;color:#fff;background:#52739a;font-family:var(--sans);font-size:.55em;vertical-align:.2em}.study-prose :global(h3){margin:1.8em 0 .65em;color:#725a3d;font-size:1.12rem}.study-prose :global(p),.study-prose :global(li){overflow-wrap:anywhere}.study-prose :global(a){color:#286d76;border-bottom:1px dashed currentColor}.study-prose :global(blockquote){margin:1.25em 0;padding:18px 22px;border-left:4px solid #6585ae;border-radius:0 15px 15px 0;color:#35546d;background:#edf3f8}.study-prose :global(code){padding:.12em .35em;border-radius:5px;color:#754d3d;background:#f1e4d0;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.87em}.study-prose :global(pre){max-width:100%;overflow:auto;padding:18px;border-radius:14px;background:#203246}.study-prose :global(pre code){color:#eef6ff;background:transparent}.study-prose :global(table){display:block;width:100%;overflow-x:auto;border-collapse:collapse;font-size:.82rem}.study-prose :global(th),.study-prose :global(td){padding:10px 12px;border:1px solid #aeb6bf;text-align:left}.study-prose :global(th){color:#fff;background:#526d8b}.study-prose :global(.study-note-toggle){min-height:36px;margin:-.7em 0 1.4em;padding:6px 11px;border:1px solid #8da2b7;border-radius:999px;color:#49657f;background:#f7fafc;cursor:pointer;font-size:.68rem}.study-prose :global(.study-note-toggle[aria-pressed="true"]){color:#fff;background:#52739a}.study-finish{margin-top:26px;padding:28px;border:1px solid #8fa2b6;border-radius:26px;background:linear-gradient(145deg,#eef4f8,#f8f5e8)}.study-finish h2{margin:7px 0 18px;color:#405c79;font-family:var(--serif)}.study-finish>div{display:grid;grid-template-columns:1fr 1fr;gap:10px}.study-finish label,.study-finish a{min-height:78px;padding:15px;border:1px solid #8fa1af;border-radius:14px;color:#4c6577;background:#fffdf5}.study-finish label{display:flex;align-items:center;gap:10px;font-size:.76rem}.study-finish a{display:grid;gap:5px}.study-finish a span{color:#72808a;font-size:.7rem}.study-chapter-nav{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:26px}.study-chapter-nav a{display:flex;min-height:100px;flex-direction:column;justify-content:center;padding:18px 22px;border:1px solid #99a8b7;border-radius:20px;color:#526875;background:rgba(255,253,246,.86)}.study-chapter-nav a:last-child{text-align:right}.study-chapter-nav small{color:#47739a}.study-chapter-nav strong{margin-top:5px;font-family:var(--serif)}@media(max-width:980px){.study-page{padding-top:105px}.study-grid{display:block}.study-directory{display:none}.study-mobile-directory{display:block;margin-bottom:18px;border:1px solid #7f91a2;border-radius:18px;background:rgba(255,253,246,.95)}.study-mobile-directory summary{display:flex;min-height:48px;align-items:center;justify-content:space-between;padding:10px 16px;color:#405f7c;cursor:pointer;font-weight:900;list-style:none}.study-mobile-directory>div{display:grid;max-height:65svh;overflow:auto;padding:5px 12px 16px}.study-mobile-directory strong{margin:12px 6px 5px;color:#745d40;font-size:.7rem}.study-mobile-directory a{display:grid;grid-template-columns:30px 1fr;min-height:44px;align-items:center;gap:6px;padding:7px;border-radius:9px;color:#5c6d77;font-size:.74rem}.study-mobile-directory a[aria-current="page"],.study-mobile-directory a.active{color:#fff;background:#536f91}}@media(max-width:600px){.study-page{padding-bottom:72px}.study-article__header,.study-prose{border-radius:22px}.study-prose{padding:24px 19px;font-size:.95rem}.study-prose :global(h2){font-size:1.42rem}.study-article__header dl,.study-finish>div{grid-template-columns:1fr}.study-finish{padding:22px 18px}.study-chapter-nav{grid-template-columns:1fr}.study-chapter-nav a:last-child{text-align:left}}
  .study-glossary{margin-top:26px;padding:28px;border:1px solid #8ea5a0;border-radius:26px;background:linear-gradient(145deg,#edf6f1,#fbf7e9)}
  .study-glossary h2{margin:7px 0 18px;color:#42685f;font-family:var(--serif)}
  .study-glossary dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:0}
  .study-glossary dl div{padding:14px;border:1px solid rgba(76,112,102,.25);border-radius:13px;background:rgba(255,255,255,.66)}
  .study-glossary dt{color:#3e6559;font-weight:900}
  .study-glossary dd{margin:5px 0 0;color:#6b7c77;font-size:.72rem;line-height:1.65}
  .study-prose :global(.katex-display){max-width:100%;overflow-x:auto;overflow-y:hidden;padding-bottom:4px}
  @media(max-width:600px){.study-glossary{padding:22px 18px}.study-glossary dl{grid-template-columns:1fr}}
</style>
