---
import BaseLayout from './BaseLayout.astro';
import RegionCanvasAtmosphere from '../components/RegionCanvasAtmosphere.astro';
import RegionDirectory from '../components/RegionDirectory.astro';

const {
  title,
  realm,
  summary,
  quote,
  functionTitle,
  functionLabel = functionTitle,
  functionDescription,
  status,
  theme,
  illustration,
  directory,
  prev,
  next,
} = Astro.props;
---

<BaseLayout
  title={`${title} · ${functionLabel}｜雲梦地志`}
  description={summary}
  image={illustration.fallback}
  searchable
  searchType="世界"
  searchTitle={title}
>
  <article class={`region-page region-page--${theme}`}>
    <RegionCanvasAtmosphere theme={theme} image={illustration.atmosphere} />
    <header class="region-hero page-shell">
      <a class="back-link" href="/">← 归览雲梦全境</a>
      <div class="region-hero__copy">
        <p class="pixel-kicker">雲梦地志 · {realm}</p>
        <h1>{functionLabel}</h1>
        <p class="region-hero__purpose"><strong>{title}</strong><i aria-hidden="true">·</i><span>{functionTitle}</span></p>
        <p>{summary}</p>
        {status !== 'active' && <span class="region-status">境中有景 · 门扉待启</span>}
      </div>
      <figure class="region-visual">
        <picture>
          <source type="image/avif" srcset={illustration.avifSrcSet} sizes={illustration.sizes} />
          <source type="image/webp" srcset={illustration.webpSrcSet} sizes={illustration.sizes} />
          <img data-region-hero-image src={illustration.fallback} alt={illustration.alt} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
        </picture>
      </figure>
      <blockquote>{quote}</blockquote>
    </header>

    {directory.presentation !== 'tabs' && <RegionDirectory title={title} directory={directory} />}

    <div class="region-story page-shell" id="region-story">
      <div class="region-story__body prose"><slot name="story" /></div>
      <aside class="region-function pixel-frame" id="region-function">
        <p class="pixel-kicker">此境所司</p>
        <h2>{functionTitle}</h2>
        <p>{functionDescription}</p>
        {status !== 'active' && <strong>此门尚隐于云中</strong>}
      </aside>
    </div>

    <div class="region-feature page-shell"><slot /></div>

    <nav class="region-nav page-shell" aria-label="相邻区域" data-pagefind-ignore>
      {prev ? <a href={`/world/${prev.data.slug}/`}><small>前一境</small><strong>{prev.data.title}</strong></a> : <span></span>}
      {next ? <a href={`/world/${next.data.slug}/`}><small>后一境</small><strong>{next.data.title}</strong></a> : <span></span>}
    </nav>
  </article>
</BaseLayout>
