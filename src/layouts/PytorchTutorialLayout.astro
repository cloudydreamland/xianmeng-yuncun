---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import type { PytorchChapter } from '../utils/pytorchTutorial';
import { pytorchCourseExtras } from '../data/pytorchCourseExtras';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  chapter: PytorchChapter;
  chapters: PytorchChapter[];
  lessons: Heading[];
  prev?: PytorchChapter;
  next?: PytorchChapter;
}

const { chapter, chapters, lessons, prev, next } = Astro.props;
const extra = pytorchCourseExtras[chapter.data.slug];
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(date);
---

<BaseLayout
  title={`${chapter.data.title}｜PyTorch 从零到大模型工程`}
  description={chapter.data.description}
  searchable
  searchType="教程"
  searchTitle={chapter.data.title}
  searchCategory="PyTorch 教程"
  searchTags={chapter.data.topics}
  searchDate={chapter.data.updatedAt}
>
  <div class="course-progress" aria-hidden="true"><span data-course-progress></span></div>
  <div class="course-page page-shell">
    <nav class="course-breadcrumb" aria-label="面包屑">
      <a href="/world/rain-bridge/">雨桥</a><span aria-hidden="true">/</span>
      <a href="/learn/pytorch/">PyTorch 修炼路线</a><span aria-hidden="true">/</span>
      <span aria-current="page">{chapter.data.title}</span>
    </nav>

    <details class="course-mobile-directory" data-pagefind-ignore>
      <summary>展开课程与本章目录 <span aria-hidden="true">⌄</span></summary>
      <div>
        <strong>{chapters.length} 章学习路线</strong>
        {chapters.map((item) => (
          <a href={`/learn/pytorch/${item.data.slug}/`} aria-current={item.id === chapter.id ? 'page' : undefined}>
            <small>{String(item.data.order).padStart(2, '0')}</small><span>{item.data.title}</span>
          </a>
        ))}
        <strong>本章课程</strong>
        {lessons.map((lesson, index) => (
          <a href={`#${lesson.slug}`} data-lesson-link={lesson.slug}>
            <small>{String(index + 1).padStart(2, '0')}</small><span>{lesson.text}</span>
          </a>
        ))}
      </div>
    </details>

    <div class="course-reading-grid">
      <aside class="course-directory" aria-label="PyTorch 教程目录" data-pagefind-ignore>
        <a class="course-directory__home" href="/learn/pytorch/">PyTorch 修炼路线</a>
        <div class="course-directory__scroll">
          <p>{chapters.length} 章路线</p>
          <nav>
            {chapters.map((item) => (
              <a href={`/learn/pytorch/${item.data.slug}/`} aria-current={item.id === chapter.id ? 'page' : undefined}>
                <small>{String(item.data.order).padStart(2, '0')}</small><span>{item.data.title}</span>
              </a>
            ))}
          </nav>
          <p>本章 {lessons.length} 节</p>
          <nav class="course-directory__lessons">
            {lessons.map((lesson, index) => (
              <a href={`#${lesson.slug}`} data-lesson-link={lesson.slug}>
                <small>{String(index + 1).padStart(2, '0')}</small><span>{lesson.text}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <article class="course-article" data-course-article>
        <header class="course-article__header">
          <p class="pixel-kicker">第 {String(chapter.data.order).padStart(2, '0')} 章 · {chapter.data.level}</p>
          <h1>{chapter.data.title}</h1>
          <p>{chapter.data.description}</p>
          <div><span>{lessons.length} 节课程</span><span>校订于 {formatDate(chapter.data.updatedAt)}</span></div>
          <div class="tag-row">{chapter.data.topics.map((topic) => <span>{topic}</span>)}</div>
          {extra && (
            <div class="course-learning-meta" data-pagefind-ignore>
              <p><strong>预计用时</strong><span>{extra.estimatedMinutes} 分钟</span></p>
              <p><strong>前置知识</strong><span>{extra.prerequisites.join(' · ')}</span></p>
              <p><strong>完成标准</strong><span>{extra.outcomes.join(' · ')}</span></p>
              <p><strong>本章进度</strong><span data-course-completion>0 / {lessons.length}</span></p>
            </div>
          )}
        </header>
        <div class="course-prose"><slot /></div>

        {extra && (
          <section class="course-practice" data-pagefind-ignore>
            <header><p class="pixel-kicker">章末资料</p><h2>小测、项目与相关面试题</h2></header>
            <div class="course-practice__quiz">
              {extra.quiz.map((item, index) => (
                <details><summary>{index + 1}. {item.question}</summary><p>{item.answer}</p></details>
              ))}
            </div>
            <div class="course-practice__actions">
              {extra.project && <a href={extra.project.href} download><strong>{extra.project.label}</strong><span>{extra.project.detail}</span></a>}
              {extra.interviewLink && <a href={extra.interviewLink.href}><strong>{extra.interviewLink.label}</strong><span>查看与本章主题相关的面试问题。</span></a>}
              <a href="/downloads/pytorch-course/verification-report.json"><strong>查看代码验证报告</strong><span>74 段语法校验、CPU 实跑与硬件边界均有记录。</span></a>
            </div>
          </section>
        )}

        <nav class="course-chapter-nav" aria-label="相邻章节" data-pagefind-ignore>
          {prev ? <a href={`/learn/pytorch/${prev.data.slug}/`}><small>← 上一章</small><strong>{prev.data.title}</strong></a> : <span></span>}
          {next ? <a href={`/learn/pytorch/${next.data.slug}/`}><small>下一章 →</small><strong>{next.data.title}</strong></a> : <a href="/learn/pytorch/"><small>完成路线</small><strong>返回课程地图</strong></a>}
        </nav>
      </article>
    </div>
  </div>

  <script>
    const prose = document.querySelector<HTMLElement>('.course-prose');
    const progress = document.querySelector<HTMLElement>('[data-course-progress]');
    const headings = [...document.querySelectorAll<HTMLElement>('.course-prose h2[id]')];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lesson-link]')];
    const completion = document.querySelector<HTMLElement>('[data-course-completion]');
    const chapterSlug = document.location.pathname.split('/').filter(Boolean).at(-1) || '';
    const storageKey = 'xianmeng:pytorch-progress:v1';
    const readCompleted = () => {
      try { return new Set<string>(JSON.parse(localStorage.getItem(storageKey) || '[]')); }
      catch { return new Set<string>(); }
    };
    const completed = readCompleted();
    const lessonKey = (id: string) => `${chapterSlug}#${id}`;
    const updateCompletion = () => {
      const count = headings.filter((heading) => completed.has(lessonKey(heading.id))).length;
      if (completion) completion.textContent = `${count} / ${headings.length}`;
    };
    headings.forEach((heading) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'lesson-complete-toggle';
      const render = () => {
        const done = completed.has(lessonKey(heading.id));
        button.setAttribute('aria-pressed', String(done));
        button.textContent = done ? '✓ 已完成' : '○ 标记完成';
      };
      button.addEventListener('click', () => {
        const key = lessonKey(heading.id);
        if (completed.has(key)) completed.delete(key); else completed.add(key);
        localStorage.setItem(storageKey, JSON.stringify([...completed]));
        render();
        updateCompletion();
      });
      heading.insertAdjacentElement('afterend', button);
      render();
    });
    document.querySelectorAll<HTMLElement>('.course-prose pre').forEach((pre, index) => {
      const code = pre.querySelector('code');
      if (!code || pre.parentElement?.classList.contains('course-code-shell')) return;
      const shell = document.createElement('div');
      shell.className = 'course-code-shell';
      const toolbar = document.createElement('div');
      toolbar.className = 'course-code-toolbar';
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.textContent = '复制代码';
      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(code.textContent || '');
        copy.textContent = '已复制';
        window.setTimeout(() => { copy.textContent = '复制代码'; }, 1600);
      });
      const download = document.createElement('button');
      download.type = 'button';
      download.textContent = '下载 .py';
      download.addEventListener('click', () => {
        const url = URL.createObjectURL(new Blob([code.textContent || ''], { type: 'text/x-python;charset=utf-8' }));
        const anchor = document.createElement('a');
        anchor.href = url;
        anchor.download = `${chapterSlug}-${index + 1}.py`;
        anchor.click();
        URL.revokeObjectURL(url);
      });
      toolbar.append(copy, download);
      pre.replaceWith(shell);
      shell.append(toolbar, pre);
    });
    const updateActive = () => {
      let active = headings[0]?.id;
      for (const heading of headings) if (heading.getBoundingClientRect().top <= 150) active = heading.id;
      links.forEach((link) => {
        const current = link.dataset.lessonLink === active;
        link.classList.toggle('active', current);
        if (current) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
      });
      if (active) {
        try {
          const title = headings.find((heading) => heading.id === active)?.textContent || document.title;
          localStorage.setItem('xianmeng:pytorch-last-read:v1', JSON.stringify({ href: `${location.pathname}#${active}`, title, updatedAt: Date.now() }));
        } catch {}
      }
    };
    const updateProgress = () => {
      if (!prose || !progress) return;
      const distance = Math.max(1, prose.offsetHeight - window.innerHeight);
      const value = Math.min(1, Math.max(0, (window.scrollY - prose.offsetTop) / distance));
      progress.style.transform = `scaleX(${value})`;
    };
    window.addEventListener('scroll', updateActive, { passive: true });
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateCompletion(); updateActive(); updateProgress();
  </script>
</BaseLayout>

<style>
  .course-progress{position:fixed;z-index:130;inset:0 0 auto;height:3px;background:rgba(255,255,255,.3);pointer-events:none}.course-progress span{display:block;width:100%;height:100%;background:linear-gradient(90deg,#5c7fbd,#53a3a1,#d69a52);transform:scaleX(0);transform-origin:left}
  .course-page{padding:118px 0 100px}.course-breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;color:var(--ink-soft);font-size:.72rem}.course-breadcrumb a{color:#426c9b}
  .course-reading-grid{display:grid;grid-template-columns:270px minmax(0,820px);gap:42px;align-items:start;justify-content:center}.course-directory{position:sticky;top:24px;max-height:calc(100svh - 48px);overflow:hidden;border:1px solid rgba(72,92,130,.22);border-radius:24px;background:rgba(255,253,246,.94);box-shadow:var(--shadow-soft)}
  .course-directory__home{display:block;padding:18px 20px;color:#fff;background:#405f87;font-family:var(--serif);font-weight:900}.course-directory__scroll{max-height:calc(100svh - 108px);overflow:auto;padding:12px 10px 18px;scrollbar-width:thin}.course-directory p{margin:12px 10px 7px;color:#766451;font-size:.62rem;font-weight:900;letter-spacing:.15em}.course-directory nav{display:grid;gap:2px}.course-directory nav a{display:grid;grid-template-columns:25px 1fr;gap:7px;align-items:start;padding:7px 9px;border-radius:10px;color:#617078;font-size:.7rem;line-height:1.5}.course-directory nav a:hover,.course-directory nav a.active{color:#315b75;background:#e4edf3}.course-directory nav a[aria-current="page"]{color:#fff;background:#506f96}.course-directory nav small{color:inherit;opacity:.68;font-variant-numeric:tabular-nums}.course-directory__lessons{padding-left:5px;border-left:1px dashed #9caab8}.course-mobile-directory{display:none}.course-article{min-width:0}
  .course-article__header{margin-bottom:28px;padding:38px clamp(24px,5vw,48px);border:1px solid rgba(76,95,134,.2);border-radius:30px;background:linear-gradient(145deg,rgba(239,245,255,.97),rgba(232,247,241,.94));box-shadow:var(--shadow-soft)}.course-article__header h1{margin:10px 0 12px;color:#344f70;font-family:var(--serif);font-size:clamp(2rem,5vw,3.25rem);line-height:1.3}.course-article__header>p:not(.pixel-kicker){max-width:660px;color:var(--ink-soft);line-height:1.8}.course-article__header>div:not(.tag-row){display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:18px;color:#607078;font-size:.72rem}.tag-row{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}.tag-row span{padding:5px 10px;border:1px solid #8ea4bd;border-radius:999px;color:#49657f;background:#fbf8e6;font-size:.66rem}
  .course-prose{min-width:0;padding:clamp(26px,5vw,56px);border:1px solid rgba(82,91,117,.14);border-radius:30px;color:#46575e;background:rgba(255,253,246,.94);box-shadow:var(--shadow-soft);font-family:var(--serif);font-size:1rem;line-height:1.95}.course-prose :global(h2){margin:3.2em 0 1em;padding-top:.25em;color:#395875;font-size:1.75rem;line-height:1.45;scroll-margin-top:28px}.course-prose :global(h2:first-child){margin-top:0}.course-prose :global(h2::before){content:"";display:inline-block;width:.65em;height:.65em;margin-right:.65em;border:3px solid #fff;border-radius:4px;background:#52739a;box-shadow:0 0 0 3px #52739a;vertical-align:.08em}.course-prose :global(h3){margin:1.8em 0 .65em;color:#725a3d;font-size:1.12rem;scroll-margin-top:28px}.course-prose :global(p),.course-prose :global(li){overflow-wrap:anywhere}.course-prose :global(a){color:#286d76;border-bottom:1px dashed currentColor}.course-prose :global(blockquote){margin:1.25em 0;padding:18px 22px;border-left:4px solid #6585ae;border-radius:0 15px 15px 0;color:#35546d;background:#edf3f8}.course-prose :global(pre),.course-prose :global(.katex-display){max-width:100%;overflow:auto}.course-prose :global(pre){margin:0;padding:18px;border-radius:0 0 14px 14px;background:#203246}.course-prose :global(pre code){color:#eef6ff;background:transparent}.course-prose :global(code){padding:.12em .35em;border-radius:5px;color:#754d3d;background:#f1e4d0;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.87em}.course-prose :global(table){display:block;width:100%;overflow-x:auto;border-collapse:collapse;font-size:.82rem}.course-prose :global(th),.course-prose :global(td){padding:10px 12px;border:1px solid #aeb6bf;text-align:left}.course-prose :global(th){color:#fff;background:#526d8b}.course-prose :global(hr){margin:3em 0;border:0;border-top:1px dashed #9ca8b5}
  .course-learning-meta{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px!important;margin-top:20px!important}.course-learning-meta p{display:grid;gap:3px;margin:0;padding:10px 12px;border:1px solid rgba(78,105,137,.2);border-radius:12px;background:rgba(255,255,255,.55)}.course-learning-meta strong{color:#405f7d;font-size:.65rem}.course-learning-meta span{color:#66757d;font-size:.68rem;line-height:1.55}
  .course-prose :global(.lesson-runtime){display:flex;flex-wrap:wrap;gap:7px 12px;margin:-.4em 0 1.6em;padding:10px 13px;border:1px solid #9aadc1;border-radius:12px;color:#576c7b;background:#f0f5f8;font-family:var(--sans);font-size:.68rem}.course-prose :global(.lesson-runtime strong){color:#365e82}.course-prose :global(.lesson-answer){margin:1em 0 1.5em;border:1px solid #a7b4a3;border-radius:13px;background:#f5f6e9}.course-prose :global(.lesson-answer summary){min-height:44px;padding:10px 14px;color:#526b58;cursor:pointer;font-family:var(--sans);font-size:.75rem;font-weight:900}.course-prose :global(.lesson-answer p){margin:0;padding:0 15px 15px}.course-prose :global(.lesson-complete-toggle){min-height:36px;margin:-.7em 0 1.4em;padding:6px 11px;border:1px solid #8da2b7;border-radius:999px;color:#49657f;background:#f7fafc;cursor:pointer;font-size:.68rem}.course-prose :global(.lesson-complete-toggle[aria-pressed="true"]){color:#fff;background:#52739a}.course-prose :global(.course-code-shell){max-width:100%;overflow:hidden;margin:1em 0;border-radius:14px}.course-prose :global(.course-code-toolbar){display:flex;justify-content:flex-end;gap:6px;padding:7px 9px;background:#17283a}.course-prose :global(.course-code-toolbar button){min-height:34px;padding:5px 10px;border:1px solid #72889c;border-radius:8px;color:#dcecff;background:#263e56;cursor:pointer;font-size:.65rem}
  .course-practice{margin-top:26px;padding:28px;border:1px solid #8fa2b6;border-radius:26px;background:linear-gradient(145deg,#eef4f8,#f8f5e8)}.course-practice h2{margin:7px 0 18px;color:#405c79;font-family:var(--serif)}.course-practice__quiz{display:grid;gap:8px}.course-practice__quiz details{border:1px solid #9babb8;border-radius:13px;background:#fffdf5}.course-practice__quiz summary{min-height:44px;padding:11px 14px;color:#405f7d;cursor:pointer;font-weight:900}.course-practice__quiz p{margin:0;padding:0 14px 14px;color:#687780;font-size:.78rem;line-height:1.7}.course-practice__actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:16px}.course-practice__actions a{display:grid;gap:5px;min-height:82px;padding:14px;border:1px solid #879db2;border-radius:14px;color:#47647e;background:#fffdf5}.course-practice__actions span{color:#74818a;font-size:.68rem;line-height:1.5}
  .course-chapter-nav{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:26px}.course-chapter-nav a{display:flex;min-height:100px;flex-direction:column;justify-content:center;padding:18px 22px;border:1px solid #99a8b7;border-radius:20px;color:#526875;background:rgba(255,253,246,.86)}.course-chapter-nav a:last-child{text-align:right}.course-chapter-nav small{color:#47739a}.course-chapter-nav strong{margin-top:5px;font-family:var(--serif)}
  @media(max-width:980px){.course-page{padding-top:105px}.course-reading-grid{display:block}.course-directory{display:none}.course-mobile-directory{display:block;margin-bottom:18px;border:1px solid #7f91a2;border-radius:18px;background:rgba(255,253,246,.95)}.course-mobile-directory summary{display:flex;min-height:48px;align-items:center;justify-content:space-between;padding:10px 16px;color:#405f7c;cursor:pointer;font-weight:900;list-style:none}.course-mobile-directory summary::-webkit-details-marker{display:none}.course-mobile-directory>div{display:grid;max-height:65svh;overflow:auto;padding:5px 12px 16px}.course-mobile-directory strong{margin:12px 6px 5px;color:#745d40;font-size:.7rem}.course-mobile-directory a{display:grid;grid-template-columns:30px 1fr;min-height:44px;align-items:center;gap:6px;padding:7px;border-radius:9px;color:#5c6d77;font-size:.74rem}.course-mobile-directory a[aria-current="page"],.course-mobile-directory a.active{color:#fff;background:#536f91}}
  @media(max-width:600px){.course-page{padding-bottom:72px}.course-breadcrumb{margin-bottom:16px}.course-article__header,.course-prose{border-radius:22px}.course-prose{padding:24px 19px;font-size:.95rem}.course-prose :global(h2){font-size:1.42rem}.course-learning-meta,.course-practice__actions{grid-template-columns:1fr}.course-practice{padding:22px 18px}.course-chapter-nav{grid-template-columns:1fr}.course-chapter-nav a:last-child{text-align:left}}
</style>
