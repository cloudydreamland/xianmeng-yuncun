<section class="life-organizer" id="life-planning" aria-labelledby="life-organizer-title" data-life-organizer data-pagefind-ignore>
  <header class="section-heading"><p class="pixel-kicker">MOON POOL · 生活安排</p><h2 id="life-organizer-title">把琐碎安放成序。</h2><p>重复清单、生活期限、轻量账目与物品位置共用一方私人账册；默认留在本机，且不进入公开搜索。</p></header>
  <nav class="life-organizer__nav" aria-label="生活安排分类"><a href="#checklists">清单</a><a href="#expiries">期限</a><a href="#ledger">账目</a><a href="#inventory">物品</a></nav>

  <section class="organizer-card" id="checklists"><header><div><span>01</span><h3>重复清单</h3><p>购物、出行、上线检查，都可以重置再用。</p></div></header><form data-checklist-form><input name="title" required maxlength="60" placeholder="清单名称" /><textarea name="items" required rows="3" placeholder="每行一项"></textarea><button type="submit">新建清单</button></form><div class="organizer-grid" data-checklist-list></div><p data-checklist-empty>尚无清单。</p></section>

  <section class="organizer-card" id="expiries"><header><div><span>02</span><h3>生活期限</h3><p>订阅、证件、保修和耗材，都在到期前看见。</p></div></header><form class="organizer-form-row" data-expiry-form><input name="title" required maxlength="80" placeholder="事项或物品" /><input name="date" type="date" required /><select name="category"><option>订阅</option><option>证件</option><option>保修</option><option>耗材</option><option>健康</option><option>其他</option></select><button type="submit">加入期限</button></form><div class="organizer-list" data-expiry-list></div><p data-expiry-empty>三十天内没有需要留意的期限。</p></section>

  <section class="organizer-card" id="ledger"><header><div><span>03</span><h3>极简账目</h3><p>只记金额、去向和日期；需要时可以导出 CSV。</p></div><strong data-ledger-total>本月 ¥0.00</strong></header><form class="organizer-form-row" data-expense-form><input name="title" required maxlength="80" placeholder="花在了什么地方" /><input name="amount" type="number" min="0.01" step="0.01" required placeholder="金额" /><select name="category"><option>餐饮</option><option>交通</option><option>购物</option><option>居家</option><option>学习</option><option>健康</option><option>其他</option></select><input name="date" type="date" required /><button type="submit">记一笔</button></form><div class="organizer-list" data-expense-list></div><div class="organizer-export"><button type="button" data-expense-export>导出 CSV</button></div><p data-expense-empty>本月尚无账目。</p></section>

  <section class="organizer-card" id="inventory"><header><div><span>04</span><h3>物品与位置</h3><p>记住东西放在哪里，以及何时购买。</p></div><label class="inventory-search">搜索<input type="search" data-inventory-search placeholder="名称或位置" /></label></header><form class="organizer-form-row" data-inventory-form><input name="title" required maxlength="80" placeholder="物品名称" /><input name="location" required maxlength="80" placeholder="位置，例如：书房第二层" /><input name="purchasedAt" type="date" /><input name="note" maxlength="160" placeholder="备注，可留空" /><button type="submit">收进物册</button></form><div class="organizer-list" data-inventory-list></div><p data-inventory-empty>物册尚空。</p></section>
</section>

<script>
  import { LIFE_KEYS,LIFE_UPDATED_EVENT,announceLifeUpdate,lifeId,localDateKey,readStored,writeStored } from '../utils/lifeStore';
  const root=document.querySelector<HTMLElement>('[data-life-organizer]');
  if(root){
    const setToday=(form:HTMLFormElement|null)=>{const field=form?.elements.namedItem('date');if(field instanceof HTMLInputElement&&!field.value)field.value=localDateKey();};
    const save=(key:string,items:any[],detail:string)=>{writeStored(localStorage,key,items);announceLifeUpdate(detail);};
    const button=(text:string,onClick:()=>void,danger=false)=>{const item=document.createElement('button');item.type='button';item.textContent=text;if(danger)item.className='danger';item.addEventListener('click',onClick);return item;};

    const checklistForm=root.querySelector<HTMLFormElement>('[data-checklist-form]');
    const readChecklists=()=>readStored<any[]>(localStorage,LIFE_KEYS.checklists,[]).filter((item)=>item&&item.id);
    const renderChecklists=()=>{const items=readChecklists();const list=root.querySelector<HTMLElement>('[data-checklist-list]');const empty=root.querySelector<HTMLElement>('[data-checklist-empty]');list?.replaceChildren(...items.map((checklist)=>{const article=document.createElement('article');const h4=document.createElement('h4');h4.textContent=checklist.title;const ul=document.createElement('ul');(checklist.items||[]).forEach((entry:any)=>{const li=document.createElement('li');const label=document.createElement('label');const input=document.createElement('input');input.type='checkbox';input.checked=Boolean(entry.done);const span=document.createElement('span');span.textContent=entry.label;input.addEventListener('change',()=>{const now=readChecklists();const target=now.find((item)=>item.id===checklist.id)?.items.find((item:any)=>item.id===entry.id);if(target)target.done=input.checked;save(LIFE_KEYS.checklists,now,'checklists');renderChecklists();});label.append(input,span);li.append(label);ul.append(li);});const footer=document.createElement('footer');footer.append(button('全部重置',()=>{const now=readChecklists();const target=now.find((item)=>item.id===checklist.id);target?.items.forEach((entry:any)=>entry.done=false);save(LIFE_KEYS.checklists,now,'checklists');renderChecklists();}),button('删除',()=>{if(confirm('删除这份清单？')){save(LIFE_KEYS.checklists,readChecklists().filter((item)=>item.id!==checklist.id),'checklists');renderChecklists();}},true));article.append(h4,ul,footer);return article;}));if(empty)empty.hidden=items.length>0;};
    checklistForm?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(checklistForm);const lines=String(data.get('items')||'').split(/\r?\n/).map((line)=>line.trim()).filter(Boolean);if(!lines.length)return;const items=readChecklists();items.push({id:lifeId('checklist'),title:String(data.get('title')).trim(),items:lines.map((label)=>({id:lifeId('check'),label,done:false})),createdAt:new Date().toISOString()});save(LIFE_KEYS.checklists,items,'checklists');checklistForm.reset();renderChecklists();});

    const expiryForm=root.querySelector<HTMLFormElement>('[data-expiry-form]');setToday(expiryForm);const readExpiries=()=>readStored<any[]>(localStorage,LIFE_KEYS.expiries,[]).filter((item)=>item&&item.id);
    const renderExpiries=()=>{const items=readExpiries().sort((a,b)=>String(a.date).localeCompare(String(b.date)));const list=root.querySelector<HTMLElement>('[data-expiry-list]');const empty=root.querySelector<HTMLElement>('[data-expiry-empty]');list?.replaceChildren(...items.map((item)=>{const article=document.createElement('article');const days=Math.ceil((Date.parse(`${item.date}T23:59:59`)-Date.now())/86400000);const copy=document.createElement('div');const strong=document.createElement('strong');strong.textContent=item.title;const small=document.createElement('small');small.textContent=`${item.category} · ${item.date} · ${days<0?`已过 ${Math.abs(days)} 天`:days===0?'今天到期':`${days} 天后`}`;copy.append(strong,small);article.append(copy,button('完成',()=>{save(LIFE_KEYS.expiries,readExpiries().filter((entry)=>entry.id!==item.id),'expiries');renderExpiries();}));return article;}));if(empty)empty.hidden=items.length>0;};
    expiryForm?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(expiryForm);const items=readExpiries();items.push({id:lifeId('expiry'),title:String(data.get('title')).trim(),date:String(data.get('date')),category:String(data.get('category')),createdAt:new Date().toISOString()});save(LIFE_KEYS.expiries,items,'expiries');expiryForm.reset();setToday(expiryForm);renderExpiries();});

    const expenseForm=root.querySelector<HTMLFormElement>('[data-expense-form]');setToday(expenseForm);const readExpenses=()=>readStored<any[]>(localStorage,LIFE_KEYS.expenses,[]).filter((item)=>item&&item.id);
    const renderExpenses=()=>{const month=localDateKey().slice(0,7);const items=readExpenses().filter((item)=>String(item.date).startsWith(month)).sort((a,b)=>String(b.date).localeCompare(String(a.date)));const list=root.querySelector<HTMLElement>('[data-expense-list]');const empty=root.querySelector<HTMLElement>('[data-expense-empty]');const total=root.querySelector<HTMLElement>('[data-ledger-total]');if(total)total.textContent=`本月 ¥${items.reduce((sum,item)=>sum+Number(item.amount||0),0).toFixed(2)}`;list?.replaceChildren(...items.slice(0,30).map((item)=>{const article=document.createElement('article');const copy=document.createElement('div');const strong=document.createElement('strong');strong.textContent=item.title;const small=document.createElement('small');small.textContent=`${item.category} · ${item.date}`;copy.append(strong,small);const amount=document.createElement('b');amount.textContent=`¥${Number(item.amount).toFixed(2)}`;article.append(copy,amount,button('删除',()=>{save(LIFE_KEYS.expenses,readExpenses().filter((entry)=>entry.id!==item.id),'expenses');renderExpenses();},true));return article;}));if(empty)empty.hidden=items.length>0;};
    expenseForm?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(expenseForm);const items=readExpenses();items.push({id:lifeId('expense'),title:String(data.get('title')).trim(),amount:Number(data.get('amount')),category:String(data.get('category')),date:String(data.get('date')),createdAt:new Date().toISOString()});save(LIFE_KEYS.expenses,items,'expenses');expenseForm.reset();setToday(expenseForm);renderExpenses();});
    root.querySelector('[data-expense-export]')?.addEventListener('click',()=>{const escape=(value:unknown)=>`"${String(value??'').replace(/"/g,'""')}"`;const rows=[['日期','分类','项目','金额'],...readExpenses().map((item)=>[item.date,item.category,item.title,item.amount])];const blob=new Blob(['\ufeff'+rows.map((row)=>row.map(escape).join(',')).join('\n')],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download=`yuncun-expenses-${localDateKey()}.csv`;link.click();setTimeout(()=>URL.revokeObjectURL(url),0);});

    const inventoryForm=root.querySelector<HTMLFormElement>('[data-inventory-form]');const readInventory=()=>readStored<any[]>(localStorage,LIFE_KEYS.inventory,[]).filter((item)=>item&&item.id);let inventoryQuery='';
    const renderInventory=()=>{const items=readInventory().filter((item)=>`${item.title} ${item.location} ${item.note||''}`.toLowerCase().includes(inventoryQuery.toLowerCase()));const list=root.querySelector<HTMLElement>('[data-inventory-list]');const empty=root.querySelector<HTMLElement>('[data-inventory-empty]');list?.replaceChildren(...items.map((item)=>{const article=document.createElement('article');const copy=document.createElement('div');const strong=document.createElement('strong');strong.textContent=item.title;const small=document.createElement('small');small.textContent=`${item.location}${item.purchasedAt?` · 购于 ${item.purchasedAt}`:''}${item.note?` · ${item.note}`:''}`;copy.append(strong,small);article.append(copy,button('移除',()=>{if(confirm('从物册移除这件物品？')){save(LIFE_KEYS.inventory,readInventory().filter((entry)=>entry.id!==item.id),'inventory');renderInventory();}},true));return article;}));if(empty)empty.hidden=items.length>0;};
    inventoryForm?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(inventoryForm);const items=readInventory();items.push({id:lifeId('inventory'),title:String(data.get('title')).trim(),location:String(data.get('location')).trim(),purchasedAt:String(data.get('purchasedAt')),note:String(data.get('note')).trim(),createdAt:new Date().toISOString()});save(LIFE_KEYS.inventory,items,'inventory');inventoryForm.reset();renderInventory();});
    root.querySelector<HTMLInputElement>('[data-inventory-search]')?.addEventListener('input',(event)=>{inventoryQuery=(event.currentTarget as HTMLInputElement).value;renderInventory();});
    const renderAll=()=>{renderChecklists();renderExpiries();renderExpenses();renderInventory();};renderAll();window.addEventListener(LIFE_UPDATED_EVENT,renderAll);window.addEventListener('storage',renderAll);
  }
</script>

<style>
  .life-organizer { margin-top:68px; }
  .life-organizer>.section-heading { max-width:850px; padding:28px; border-left:5px solid #7ab1a8; color:#d9efec; background:rgba(13,43,48,.9); }
  .life-organizer>.section-heading h2 { color:#f7edcf; }
  .life-organizer__nav { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:20px 0; }.life-organizer__nav a{padding:12px;border:2px solid #647c72;color:#3d594e;background:#eef0d6;text-align:center;font-weight:900}
  .organizer-card { margin-top:18px; padding:clamp(18px,3vw,28px); border:3px solid #63786f; color:#45584f; background:rgba(249,247,224,.96); box-shadow:7px 7px 0 rgba(35,59,50,.2); scroll-margin-top:100px; }
  .organizer-card>header { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:18px; }.organizer-card>header>div{display:grid;grid-template-columns:38px 1fr;gap:2px 10px}.organizer-card>header span{grid-row:1/3;color:#7b897f;font-family:monospace}.organizer-card h3{margin:0;color:#3f594d;font-family:var(--serif);font-size:1.7rem}.organizer-card header p{grid-column:2;margin:3px 0 0;color:#6c7a72;font-size:.72rem}.organizer-card>header>strong{color:#3f6958;font-family:var(--serif);font-size:1.25rem}
  .organizer-card form { display:grid; gap:8px; margin-bottom:17px; }.organizer-card form input,.organizer-card form select,.organizer-card form textarea{min-width:0;min-height:42px;padding:8px 10px;border:2px solid #7d8d84;color:#43544c;background:#fffdf2;font:inherit}.organizer-card form textarea{resize:vertical;line-height:1.55}.organizer-card form button,.organizer-export button{padding:9px 12px;border:2px solid #526d60;color:#fff;background:#597d6c;cursor:pointer;font-weight:900}.organizer-form-row{grid-template-columns:2fr 1fr 1fr auto;align-items:stretch}
  .organizer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.organizer-grid article{padding:16px;border:2px solid #89948a;background:#fff9e5}.organizer-grid h4{margin:0 0 10px;color:#4b5f54;font-family:var(--serif)}.organizer-grid ul{display:grid;gap:5px;margin:0;padding:0;list-style:none}.organizer-grid label{display:flex;gap:8px;align-items:start}.organizer-grid input:checked+span{text-decoration:line-through;opacity:.6}.organizer-grid footer{display:flex;justify-content:space-between;margin-top:13px;padding-top:10px;border-top:1px dashed #a0a79d}
  .organizer-grid button,.organizer-list button{border:0;color:#4d6a5d;background:transparent;cursor:pointer}.organizer-grid .danger,.organizer-list .danger{color:#915346}.organizer-list{display:grid;gap:7px}.organizer-list article{display:flex;align-items:center;gap:12px;padding:11px 13px;border-left:4px solid #718b7b;background:#fff9e7}.organizer-list article>div{display:grid;gap:3px;min-width:0;margin-right:auto}.organizer-list small{overflow-wrap:anywhere;color:#718078;font-size:.64rem}.organizer-list b{color:#54685d}.organizer-export{display:flex;justify-content:flex-end;margin-top:12px}.inventory-search{display:grid;gap:4px;color:#6c7c73;font-size:.62rem}.inventory-search input{min-height:38px;padding:7px 9px;border:2px solid #7b8d83;background:#fffdf2}
  .organizer-card>p{padding:16px;border:1px dashed #89968e;color:#78847d;text-align:center}.organizer-card>p[hidden]{display:none}
  @media(max-width:760px){.life-organizer__nav{grid-template-columns:1fr 1fr}.organizer-form-row{grid-template-columns:1fr}.organizer-grid{grid-template-columns:1fr}.organizer-card>header{align-items:start;flex-direction:column}.organizer-list article{align-items:start;flex-wrap:wrap}.organizer-list article>div{flex-basis:70%}}
</style>
