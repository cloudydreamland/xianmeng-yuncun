<button class="reminder-launcher" type="button" data-reminder-open aria-label="打开提醒中心">
  <span aria-hidden="true">铃</span><b data-reminder-badge hidden>0</b>
</button>

<dialog class="reminder-center pixel-frame" data-reminder-center aria-labelledby="reminder-center-title">
  <div class="reminder-center__shell">
    <header>
      <div><p class="pixel-kicker">REMINDERS · 云铃</p><h2 id="reminder-center-title">提醒中心</h2><p>汇集定时日程与生活期限；错过的提醒也会留在这里。</p></div>
      <button type="button" data-reminder-close aria-label="关闭提醒中心">×</button>
    </header>
    <form class="reminder-center__form" data-reminder-form>
      <label>提醒内容<input name="title" maxlength="80" required placeholder="例如：出门带伞" /></label>
      <label>日期<input name="date" type="date" required /></label>
      <label>时间<input name="time" type="time" required /></label>
      <button class="pixel-button pixel-button--primary" type="submit">加入云铃</button>
    </form>
    <div class="reminder-center__permission">
      <div><strong data-reminder-permission-title>站内提醒已可用</strong><span data-reminder-permission-copy>允许系统通知后，切到其他标签页也能看见。</span></div>
      <button class="pixel-button" type="button" data-reminder-permission>允许系统通知</button>
    </div>
    <nav aria-label="提醒筛选"><button class="active" type="button" data-reminder-filter="attention">待处理</button><button type="button" data-reminder-filter="upcoming">未来七天</button><button type="button" data-reminder-filter="all">全部</button></nav>
    <div class="reminder-center__list" data-reminder-list></div>
    <p class="reminder-center__empty" data-reminder-empty>此刻没有需要提醒的事项。</p>
    <footer><a href="/world/moon-pool/#calendar">打开生活日历</a><span>系统通知需保持网站或已安装的应用可运行。</span></footer>
  </div>
</dialog>

<script>
  import { LIFE_KEYS, LIFE_UPDATED_EVENT, announceLifeUpdate, lifeId, localDateKey, readStored, writeStored } from '../utils/lifeStore';
  interface Plan { id:string; title:string; date:string; time?:string; completed?:boolean; reminderMinutes?:number; }
  interface Expiry { id:string; title:string; date:string; category?:string; }
  interface Reminder { key:string; title:string; dueAt:number; alertAt:number; detail:string; }
  interface ReminderState { dismissed:Record<string,number>; snoozed:Record<string,number>; notified:Record<string,number>; }

  const dialog=document.querySelector<HTMLDialogElement>('[data-reminder-center]');
  if(dialog){
    const list=dialog.querySelector<HTMLElement>('[data-reminder-list]')!;const empty=dialog.querySelector<HTMLElement>('[data-reminder-empty]')!;const badge=document.querySelector<HTMLElement>('[data-reminder-badge]');const form=dialog.querySelector<HTMLFormElement>('[data-reminder-form]')!;
    let filter:'attention'|'upcoming'|'all'='attention';let timer:number|undefined;
    const blank=():ReminderState=>({dismissed:{},snoozed:{},notified:{}});
    const readState=()=>{const value=readStored<ReminderState>(localStorage,LIFE_KEYS.reminders,blank());return{dismissed:value.dismissed||{},snoozed:value.snoozed||{},notified:value.notified||{}};};
    const saveState=(value:ReminderState)=>{writeStored(localStorage,LIFE_KEYS.reminders,value);window.dispatchEvent(new CustomEvent('yuncun-sync-dirty'));};
    const due=(date:string,time='09:00')=>Date.parse(`${date}T${time||'09:00'}:00`);
    const readItems=():Reminder[]=>{
      const plans=readStored<Plan[]>(localStorage,LIFE_KEYS.plans,[]).filter((item)=>item?.id&&item.date&&!item.completed);
      const expiries=readStored<Expiry[]>(localStorage,LIFE_KEYS.expiries,[]).filter((item)=>item?.id&&item.date);
      return [...plans.map((item)=>{const dueAt=due(item.date,item.time);const lead=Number.isFinite(item.reminderMinutes)?Number(item.reminderMinutes):item.time?0:720;return{key:`plan:${item.id}:${item.date}:${item.time||''}`,title:item.title,dueAt,alertAt:lead<0?Number.POSITIVE_INFINITY:dueAt-lead*60_000,detail:`日程 · ${item.date}${item.time?` ${item.time}`:''}`};}),...expiries.map((item)=>{const dueAt=due(item.date);return{key:`expiry:${item.id}:${item.date}`,title:item.title,dueAt,alertAt:dueAt-3*86_400_000,detail:`${item.category||'生活期限'} · ${item.date}`};})].filter((item)=>Number.isFinite(item.alertAt)).sort((a,b)=>a.alertAt-b.alertAt);
    };
    const shown=()=>{const now=Date.now(),end=now+7*86_400_000,current=readState();return readItems().filter((item)=>{if(current.dismissed[item.key])return false;const at=current.snoozed[item.key]||item.alertAt;return filter==='attention'?at<=now:filter==='upcoming'?at>now&&at<=end:true;});};
    const format=(time:number)=>new Intl.DateTimeFormat('zh-CN',{month:'2-digit',day:'2-digit',weekday:'short',hour:'2-digit',minute:'2-digit'}).format(new Date(time));
    const makeButton=(label:string,onClick:()=>void,danger=false)=>{const button=document.createElement('button');button.type='button';button.textContent=label;if(danger)button.className='danger';button.addEventListener('click',onClick);return button;};
    const renderPermission=()=>{const button=dialog.querySelector<HTMLButtonElement>('[data-reminder-permission]')!,title=dialog.querySelector<HTMLElement>('[data-reminder-permission-title]')!,copy=dialog.querySelector<HTMLElement>('[data-reminder-permission-copy]')!;if(!('Notification'in window)){title.textContent='当前浏览器不支持系统通知';copy.textContent='站内提醒仍会正常显示。';button.hidden=true;return;}button.hidden=Notification.permission==='granted';title.textContent=Notification.permission==='granted'?'系统通知已开启':Notification.permission==='denied'?'系统通知已被浏览器阻止':'站内提醒已可用';copy.textContent=Notification.permission==='granted'?'云铃到点后会弹出系统通知。':Notification.permission==='denied'?'可在浏览器的网站权限中重新开启。':'允许后，切到其他标签页也能看见。';};
    const render=()=>{const current=readState(),now=Date.now(),items=shown();list.replaceChildren(...items.map((item)=>{const article=document.createElement('article'),copy=document.createElement('div'),strong=document.createElement('strong'),meta=document.createElement('span'),controls=document.createElement('div'),at=current.snoozed[item.key]||item.alertAt;strong.textContent=item.title;meta.textContent=`${item.detail} · ${at<=now?'该提醒已到':'提醒于 '+format(at)}`;copy.append(strong,meta);if(at<=now)controls.append(makeButton('稍后 10 分钟',()=>{const next=readState();next.snoozed[item.key]=Date.now()+600_000;delete next.notified[item.key];saveState(next);render();schedule();}));controls.append(makeButton('不再提醒',()=>{const next=readState();next.dismissed[item.key]=Date.now();saveState(next);render();schedule();},true));article.append(copy,controls);return article;}));empty.hidden=items.length>0;const attention=readItems().filter((item)=>!current.dismissed[item.key]&&(current.snoozed[item.key]||item.alertAt)<=now).length;if(badge){badge.textContent=String(attention);badge.hidden=attention===0;}renderPermission();};
    const notify=async(item:Reminder)=>{if(!('Notification'in window)||Notification.permission!=='granted')return;const options:NotificationOptions={body:item.detail,tag:`yuncun-${item.key}`,icon:'/icons/yuncun-app-192.png',badge:'/icons/yuncun-app-192.png'};try{const registration=await navigator.serviceWorker?.ready;if(registration)await registration.showNotification(`云铃 · ${item.title}`,options);else new Notification(`云铃 · ${item.title}`,options);}catch{try{new Notification(`云铃 · ${item.title}`,options);}catch{}}};
    const schedule=()=>{window.clearTimeout(timer);const now=Date.now(),current=readState(),items=readItems();let changed=false;items.filter((item)=>!current.dismissed[item.key]&&!current.notified[item.key]&&(current.snoozed[item.key]||item.alertAt)<=now).forEach((item)=>{current.notified[item.key]=now;changed=true;notify(item);});if(changed)saveState(current);const next=items.map((item)=>current.snoozed[item.key]||item.alertAt).filter((time)=>time>now).sort((a,b)=>a-b)[0];if(next)timer=window.setTimeout(()=>{render();schedule();},Math.min(next-now,2_147_000_000));};
    document.querySelectorAll('[data-reminder-open]').forEach((button)=>button.addEventListener('click',()=>{dialog.showModal();render();}));dialog.querySelector('[data-reminder-close]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close();});
    dialog.querySelector('[data-reminder-permission]')?.addEventListener('click',async()=>{if('Notification'in window)await Notification.requestPermission();renderPermission();schedule();});dialog.querySelectorAll<HTMLButtonElement>('[data-reminder-filter]').forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.reminderFilter as typeof filter;dialog.querySelectorAll('[data-reminder-filter]').forEach((node)=>node.classList.toggle('active',node===button));render();}));
    form.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(form),now=new Date().toISOString(),plans=readStored<any[]>(localStorage,LIFE_KEYS.plans,[]);plans.push({id:lifeId('plan'),title:String(data.get('title')).trim(),date:String(data.get('date')),time:String(data.get('time')),notes:'',completed:false,reminderMinutes:0,priority:'medium',recurrence:'none',createdAt:now,updatedAt:now});writeStored(localStorage,LIFE_KEYS.plans,plans);announceLifeUpdate('plans');window.dispatchEvent(new CustomEvent('yuncun-local-plans-updated'));form.reset();const date=form.elements.namedItem('date');if(date instanceof HTMLInputElement)date.value=localDateKey();render();schedule();});
    const date=form.elements.namedItem('date');if(date instanceof HTMLInputElement)date.value=localDateKey();window.addEventListener(LIFE_UPDATED_EVENT,()=>{render();schedule();});window.addEventListener('yuncun-local-plans-updated',()=>{render();schedule();});window.addEventListener('storage',()=>{render();schedule();});window.addEventListener('online',schedule);render();schedule();
  }
</script>

<style>
  .reminder-launcher{position:fixed;right:18px;bottom:86px;z-index:82;width:46px;height:46px;border:2px solid #54746f;border-radius:50%;color:#fff;background:#3e6f69;box-shadow:3px 4px 0 rgba(19,48,46,.3);cursor:pointer;font-weight:900}.reminder-launcher b{position:absolute;right:-4px;top:-5px;min-width:20px;padding:2px 5px;border:2px solid #fff;border-radius:12px;color:#fff;background:#a34f42;font-size:.62rem}.reminder-center{width:min(760px,calc(100vw - 24px));max-height:calc(100svh - 24px);padding:0;overflow:auto;border:3px solid #53747a;color:#40595d;background:#f3f7e9}.reminder-center::backdrop{background:rgba(10,28,34,.66);backdrop-filter:blur(5px)}.reminder-center__shell{padding:clamp(18px,4vw,30px)}.reminder-center header{display:flex;justify-content:space-between;gap:20px}.reminder-center h2{margin:0;color:#315f67;font-family:var(--serif);font-size:2.2rem}.reminder-center header p:last-child{color:#66777a}.reminder-center header>button{border:0;color:#587176;background:transparent;cursor:pointer;font-size:1.9rem}.reminder-center__form{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;align-items:end;margin:20px 0}.reminder-center__form label{display:grid;gap:5px;color:#567075;font-size:.66rem;font-weight:900}.reminder-center__form input{min-width:0;min-height:42px;padding:8px;border:2px solid #748b8d;background:#fffdf1;font:inherit}.reminder-center__permission{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px;border:2px dashed #7f9593;background:#e8f2ea}.reminder-center__permission div{display:grid;gap:3px}.reminder-center__permission span{color:#6b7b78;font-size:.66rem}.reminder-center nav{display:flex;gap:7px;margin:20px 0 12px}.reminder-center nav button{padding:7px 10px;border:2px solid #748a88;color:#4d6867;background:#e4eee4;cursor:pointer;font-weight:900}.reminder-center nav button.active{color:#fff;background:#4c7470}.reminder-center__list{display:grid;gap:8px}.reminder-center__list article{display:flex;align-items:center;gap:14px;padding:13px 14px;border-left:4px solid #738e7d;background:#fffbea}.reminder-center__list article>div:first-child{display:grid;gap:4px;min-width:0;margin-right:auto}.reminder-center__list span{color:#6d7c76;font-size:.65rem}.reminder-center__list article>div:last-child{display:flex;gap:6px}.reminder-center__list button{padding:6px 8px;border:1px solid #718782;color:#42635e;background:#e9f1e6;cursor:pointer}.reminder-center__list .danger{color:#8b5046}.reminder-center__empty{padding:28px;border:2px dashed #849590;text-align:center;color:#70807a}.reminder-center footer{display:flex;justify-content:space-between;gap:14px;margin-top:18px;padding-top:14px;border-top:1px dashed #8b9994;color:#74817d;font-size:.64rem}.reminder-center footer a{color:#386967;font-weight:900}@media(max-width:700px){.reminder-launcher{right:12px;bottom:76px}.reminder-center__form{grid-template-columns:1fr 1fr}.reminder-center__form label:first-child{grid-column:1/-1}.reminder-center__form button{grid-column:1/-1}.reminder-center__permission,.reminder-center footer{align-items:start;flex-direction:column}.reminder-center__list article{align-items:start;flex-direction:column}.reminder-center__list article>div:last-child{width:100%;flex-wrap:wrap}}
</style>
