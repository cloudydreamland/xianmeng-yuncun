<section class="life-calendar" id="calendar" aria-labelledby="life-calendar-title" data-life-calendar data-pagefind-ignore>
  <header class="life-calendar__heading">
    <div><p class="pixel-kicker">MOON POOL · 生活日历</p><h2 id="life-calendar-title">把将至之事，铺在月光下。</h2><p>私人日程与生活期限共用一张月历；可切换周视图，也可在选中日期快速添事。</p></div>
    <div class="life-calendar__view" role="group" aria-label="日历视图"><button class="active" type="button" data-calendar-view="month">月</button><button type="button" data-calendar-view="week">周</button></div>
  </header>
  <div class="life-calendar__toolbar">
    <button type="button" data-calendar-prev aria-label="上一段">←</button><button type="button" data-calendar-today>回到今天</button><button type="button" data-calendar-next aria-label="下一段">→</button><strong data-calendar-label></strong>
  </div>
  <div class="life-calendar__weekdays" aria-hidden="true"><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span></div>
  <div class="life-calendar__grid" data-calendar-grid></div>
  <aside class="life-calendar__agenda">
    <header><div><span data-calendar-selected-label></span><h3>当日安排</h3></div><button type="button" data-reminder-open>打开提醒中心</button></header>
    <div data-calendar-agenda></div><p data-calendar-empty>这一天还没有安排。</p>
    <form data-calendar-add><input name="title" maxlength="80" required placeholder="在选中日期添一件事" /><input name="time" type="time" /><button type="submit">加入日程</button></form>
  </aside>
</section>

<script>
  import { LIFE_KEYS, LIFE_UPDATED_EVENT, announceLifeUpdate, lifeId, localDateKey, readStored, writeStored } from '../utils/lifeStore';
  interface Plan{id:string;title:string;date:string;time?:string;completed?:boolean;priority?:string;notes?:string;createdAt?:string;updatedAt?:string;}
  interface Expiry{id:string;title:string;date:string;category?:string;}
  interface CalendarItem{id:string;title:string;date:string;time?:string;kind:'plan'|'expiry';completed?:boolean;}
  const root=document.querySelector<HTMLElement>('[data-life-calendar]');
  if(root){
    let view:'month'|'week'='month';let cursor=new Date();let selected=localDateKey();
    const dateKey=(date:Date)=>{const offset=date.getTimezoneOffset()*60_000;return new Date(date.valueOf()-offset).toISOString().slice(0,10);};
    const fromKey=(key:string)=>new Date(`${key}T12:00:00`);
    const startOfWeek=(value:Date)=>{const date=new Date(value);const day=(date.getDay()+6)%7;date.setDate(date.getDate()-day);return date;};
    const addDays=(date:Date,days:number)=>{const next=new Date(date);next.setDate(next.getDate()+days);return next;};
    const readItems=():CalendarItem[]=>[...readStored<Plan[]>(localStorage,LIFE_KEYS.plans,[]).filter((item)=>item?.id&&item.date).map((item)=>({id:item.id,title:item.title,date:item.date,time:item.time,kind:'plan' as const,completed:item.completed})),...readStored<Expiry[]>(localStorage,LIFE_KEYS.expiries,[]).filter((item)=>item?.id&&item.date).map((item)=>({id:item.id,title:item.title,date:item.date,kind:'expiry' as const}))];
    const range=()=>{if(view==='week'){const start=startOfWeek(cursor);return Array.from({length:7},(_,index)=>addDays(start,index));}const first=new Date(cursor.getFullYear(),cursor.getMonth(),1,12);const start=startOfWeek(first);return Array.from({length:42},(_,index)=>addDays(start,index));};
    const renderAgenda=()=>{const agenda=root.querySelector<HTMLElement>('[data-calendar-agenda]')!,empty=root.querySelector<HTMLElement>('[data-calendar-empty]')!,label=root.querySelector<HTMLElement>('[data-calendar-selected-label]')!;const entries=readItems().filter((item)=>item.date===selected).sort((a,b)=>(a.time||'99:99').localeCompare(b.time||'99:99'));label.textContent=new Intl.DateTimeFormat('zh-CN',{month:'long',day:'numeric',weekday:'long'}).format(fromKey(selected));agenda.replaceChildren(...entries.map((item)=>{const article=document.createElement('article');const mark=document.createElement('span');mark.textContent=item.kind==='expiry'?'期':item.completed?'✓':'事';const copy=document.createElement('div');const strong=document.createElement('strong');strong.textContent=item.title;const small=document.createElement('small');small.textContent=item.kind==='expiry'?'生活期限':item.time||'全天';copy.append(strong,small);article.append(mark,copy);return article;}));empty.hidden=entries.length>0;};
    const render=()=>{const days=range(),items=readItems(),grid=root.querySelector<HTMLElement>('[data-calendar-grid]')!,label=root.querySelector<HTMLElement>('[data-calendar-label]')!;label.textContent=view==='month'?new Intl.DateTimeFormat('zh-CN',{year:'numeric',month:'long'}).format(cursor):`${new Intl.DateTimeFormat('zh-CN',{month:'2-digit',day:'2-digit'}).format(days[0])} — ${new Intl.DateTimeFormat('zh-CN',{month:'2-digit',day:'2-digit'}).format(days[days.length-1])}`;grid.classList.toggle('is-week',view==='week');grid.replaceChildren(...days.map((date)=>{const key=dateKey(date),entries=items.filter((item)=>item.date===key),button=document.createElement('button');button.type='button';button.className='life-calendar__day';button.classList.toggle('is-outside',view==='month'&&date.getMonth()!==cursor.getMonth());button.classList.toggle('is-today',key===localDateKey());button.classList.toggle('is-selected',key===selected);button.setAttribute('aria-label',`${key}，${entries.length} 项安排`);const number=document.createElement('strong');number.textContent=String(date.getDate());const stack=document.createElement('span');entries.slice(0,3).forEach((item)=>{const line=document.createElement('i');line.className=`is-${item.kind}${item.completed?' is-completed':''}`;line.textContent=`${item.time?item.time+' ':''}${item.title}`;stack.append(line);});if(entries.length>3){const more=document.createElement('i');more.textContent=`另 ${entries.length-3} 项`;stack.append(more);}button.append(number,stack);button.addEventListener('click',()=>{selected=key;cursor=new Date(date);render();});return button;}));renderAgenda();};
    root.querySelectorAll<HTMLButtonElement>('[data-calendar-view]').forEach((button)=>button.addEventListener('click',()=>{view=button.dataset.calendarView as typeof view;root.querySelectorAll('[data-calendar-view]').forEach((node)=>node.classList.toggle('active',node===button));render();}));
    root.querySelector('[data-calendar-prev]')?.addEventListener('click',()=>{view==='month'?cursor.setMonth(cursor.getMonth()-1):cursor.setDate(cursor.getDate()-7);render();});root.querySelector('[data-calendar-next]')?.addEventListener('click',()=>{view==='month'?cursor.setMonth(cursor.getMonth()+1):cursor.setDate(cursor.getDate()+7);render();});root.querySelector('[data-calendar-today]')?.addEventListener('click',()=>{cursor=new Date();selected=localDateKey();render();});
    root.querySelector<HTMLFormElement>('[data-calendar-add]')?.addEventListener('submit',(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement,data=new FormData(form),now=new Date().toISOString(),plans=readStored<any[]>(localStorage,LIFE_KEYS.plans,[]);plans.push({id:lifeId('plan'),title:String(data.get('title')).trim(),date:selected,time:String(data.get('time')),priority:'medium',notes:'',completed:false,reminderMinutes:String(data.get('time'))?0:-1,recurrence:'none',createdAt:now,updatedAt:now});writeStored(localStorage,LIFE_KEYS.plans,plans);announceLifeUpdate('plans');window.dispatchEvent(new CustomEvent('yuncun-local-plans-updated'));form.reset();render();});
    window.addEventListener(LIFE_UPDATED_EVENT,render);window.addEventListener('yuncun-local-plans-updated',render);window.addEventListener('storage',render);render();
  }
</script>

<style>
  .life-calendar{margin-top:68px;padding:clamp(18px,4vw,32px);border:3px solid #60766e;color:#42574e;background:rgba(248,247,224,.96);box-shadow:8px 8px 0 rgba(31,54,47,.23);scroll-margin-top:90px}.life-calendar__heading{display:flex;align-items:end;justify-content:space-between;gap:22px}.life-calendar__heading h2{margin:0;color:#3d594d;font-family:var(--serif);font-size:clamp(2rem,4vw,3.3rem)}.life-calendar__heading p:last-child{max-width:760px;color:#6a7870;line-height:1.75}.life-calendar__view{display:flex;gap:5px}.life-calendar button{cursor:pointer}.life-calendar__view button,.life-calendar__toolbar button{padding:7px 11px;border:2px solid #72857b;color:#50675b;background:#edf0d7;font-weight:900}.life-calendar__view button.active{color:#fff;background:#4f7564}.life-calendar__toolbar{display:flex;align-items:center;gap:7px;margin:22px 0 12px}.life-calendar__toolbar strong{margin-left:auto;color:#415f50;font-family:var(--serif);font-size:1.35rem}.life-calendar__weekdays,.life-calendar__grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.life-calendar__weekdays span{padding:8px;text-align:center;color:#718078;font-size:.64rem;font-weight:900}.life-calendar__grid{border-top:2px solid #71837a;border-left:2px solid #71837a}.life-calendar__day{min-width:0;min-height:112px;padding:8px;border:0;border-right:2px solid #71837a;border-bottom:2px solid #71837a;color:#465b50;background:#fffced;text-align:left}.life-calendar__day>strong{display:block;margin-bottom:7px;font-family:var(--serif)}.life-calendar__day>span{display:grid;gap:3px}.life-calendar__day i{overflow:hidden;padding:3px 4px;color:#48645b;background:#e6ecda;font-size:.58rem;font-style:normal;text-overflow:ellipsis;white-space:nowrap}.life-calendar__day i.is-expiry{color:#815244;background:#f2ddd0}.life-calendar__day i.is-completed{text-decoration:line-through;opacity:.55}.life-calendar__day.is-outside{opacity:.4}.life-calendar__day.is-today>strong{display:inline-block;padding:2px 6px;color:#fff;background:#4e7969}.life-calendar__day.is-selected{box-shadow:inset 0 0 0 3px #4e7c73}.life-calendar__grid.is-week .life-calendar__day{min-height:180px}.life-calendar__agenda{margin-top:18px;padding:18px;border:2px solid #73867c;background:#f2f2db}.life-calendar__agenda>header{display:flex;justify-content:space-between;gap:16px}.life-calendar__agenda h3{margin:3px 0 0;color:#405c4f;font-family:var(--serif)}.life-calendar__agenda header span{color:#748178;font-size:.65rem}.life-calendar__agenda header button{border:0;color:#3e6e61;background:transparent;font-weight:900}.life-calendar__agenda>[data-calendar-agenda]{display:grid;gap:6px;margin-top:13px}.life-calendar__agenda article{display:flex;align-items:center;gap:10px;padding:9px 11px;background:#fffced}.life-calendar__agenda article>span{display:grid;width:25px;height:25px;place-items:center;color:#fff;background:#5b796b;font-size:.63rem}.life-calendar__agenda article div{display:grid}.life-calendar__agenda small{color:#758078;font-size:.6rem}.life-calendar__agenda>p{color:#748079;font-size:.7rem}.life-calendar__agenda form{display:grid;grid-template-columns:1fr 130px auto;gap:7px;margin-top:14px}.life-calendar__agenda input{min-width:0;min-height:41px;padding:8px;border:2px solid #7b8b82;background:#fffdf1;font:inherit}.life-calendar__agenda form button{border:2px solid #526d60;color:#fff;background:#597d6c;font-weight:900}@media(max-width:700px){.life-calendar__heading{align-items:start;flex-direction:column}.life-calendar{padding:18px 12px}.life-calendar__day{min-height:80px;padding:5px}.life-calendar__day i{width:7px;height:7px;padding:0;border-radius:50%;color:transparent}.life-calendar__day i.is-expiry{color:transparent}.life-calendar__grid.is-week .life-calendar__day{min-height:110px}.life-calendar__agenda form{grid-template-columns:1fr 110px}.life-calendar__agenda form button{grid-column:1/-1;min-height:42px}.life-calendar__toolbar{flex-wrap:wrap}.life-calendar__toolbar strong{width:100%;margin:5px 0 0}}
</style>
