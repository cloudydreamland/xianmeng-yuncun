<section class="memory-journal" id="journal" aria-labelledby="memory-journal-title" data-memory-journal data-pagefind-ignore>
  <header class="section-heading"><p class="pixel-kicker">LANTERN LANE · 手记</p><h2 id="memory-journal-title">浮光手记</h2><p>记录日期、心情和当天想留下的内容。</p></header>
  <div class="memory-journal__layout">
    <form class="pixel-frame" data-journal-form><div class="memory-journal__row"><label>日期<input name="date" type="date" required /></label><label>心情<select name="mood"><option>平静</option><option>愉快</option><option>充实</option><option>疲惫</option><option>低落</option><option>期待</option></select></label></div><label>标题<input name="title" required maxlength="80" autocomplete="off" placeholder="今天想记录什么？" /></label><label>正文<textarea name="body" maxlength="2000" rows="6" placeholder="写下今天的记录"></textarea></label><button class="pixel-button pixel-button--primary" type="submit">保存手记</button></form>
    <div><div class="memory-journal__toolbar"><strong>最近手记</strong><span data-journal-count>0 则</span></div><div class="memory-journal__list" data-journal-list></div><p class="memory-journal__empty" data-journal-empty>还没有手记。</p></div>
  </div>
</section>

<script>
  import { LIFE_KEYS,LIFE_UPDATED_EVENT,announceLifeUpdate,lifeId,localDateKey,readStored,writeStored } from '../utils/lifeStore';
  const root=document.querySelector<HTMLElement>('[data-memory-journal]');
  if(root){const form=root.querySelector<HTMLFormElement>('[data-journal-form]');const date=form?.elements.namedItem('date');if(date instanceof HTMLInputElement)date.value=localDateKey();
    const read=()=>readStored<any[]>(localStorage,LIFE_KEYS.journal,[]).filter((item)=>item&&item.id);const save=(items:any[])=>{writeStored(localStorage,LIFE_KEYS.journal,items);announceLifeUpdate('journal');};
    const render=()=>{const items=read().sort((a,b)=>String(b.date).localeCompare(String(a.date))||String(b.createdAt).localeCompare(String(a.createdAt)));const list=root.querySelector<HTMLElement>('[data-journal-list]');const empty=root.querySelector<HTMLElement>('[data-journal-empty]');const count=root.querySelector<HTMLElement>('[data-journal-count]');if(count)count.textContent=`${items.length} 则`;list?.replaceChildren(...items.slice(0,20).map((item)=>{const article=document.createElement('article');const header=document.createElement('header');const time=document.createElement('time');time.dateTime=item.date;time.textContent=item.date;const mood=document.createElement('span');mood.textContent=item.mood||'日常';header.append(time,mood);const title=document.createElement('h3');title.textContent=item.title;const body=document.createElement('p');body.textContent=item.body||'';const remove=document.createElement('button');remove.type='button';remove.textContent='删除';remove.addEventListener('click',()=>{if(confirm('删除这则手记？')){save(read().filter((entry)=>entry.id!==item.id));render();}});article.append(header,title,body,remove);return article;}));if(empty)empty.hidden=items.length>0;};
    form?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(form);const items=read();items.unshift({id:lifeId('journal'),date:String(data.get('date')),mood:String(data.get('mood')),title:String(data.get('title')).trim(),body:String(data.get('body')).trim(),createdAt:new Date().toISOString()});save(items);form.reset();const date=form.elements.namedItem('date');if(date instanceof HTMLInputElement)date.value=localDateKey();render();});render();window.addEventListener(LIFE_UPDATED_EVENT,render);window.addEventListener('storage',render);}
</script>

<style>
  .memory-journal { margin-top:68px; }
  .memory-journal>.section-heading { max-width:820px; padding:28px; border-left:5px solid #dcaf75; color:#f5e8d5; background:rgba(52,33,38,.86); }
  .memory-journal>.section-heading h2 { color:#fff0c7; }
  .memory-journal__layout { display:grid; grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr); gap:20px; margin-top:20px; }
  .memory-journal form { display:grid; gap:15px; align-content:start; padding:24px; border-color:#8d6b58; background:rgba(255,246,222,.96); }
  .memory-journal form label { display:grid; gap:6px; color:#6d5147; font-size:.7rem; font-weight:900; }
  .memory-journal input,.memory-journal select,.memory-journal textarea { width:100%; min-height:43px; padding:9px 10px; border:2px solid #967a68; color:#5c453e; background:#fffaf0; font:inherit; }.memory-journal textarea{resize:vertical;line-height:1.65}
  .memory-journal__row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .memory-journal__toolbar { display:flex; justify-content:space-between; padding:12px 14px; color:#6a5147; background:#f4dcaf; }.memory-journal__toolbar span{font-size:.68rem}
  .memory-journal__list { display:grid; gap:9px; margin-top:9px; }.memory-journal__list article{position:relative;padding:17px 52px 17px 18px;border:2px solid #957666;background:#fff7df}.memory-journal__list header{display:flex;gap:10px;color:#8c7468;font-size:.62rem}.memory-journal__list h3{margin:9px 0 5px;color:#674b42;font-family:var(--serif)}.memory-journal__list p{margin:0;color:#775f55;white-space:pre-wrap;line-height:1.7}.memory-journal__list button{position:absolute;top:12px;right:10px;border:0;color:#966055;background:transparent;cursor:pointer}.memory-journal__empty{padding:28px;border:2px dashed #a18470;color:#866c61;text-align:center;background:rgba(255,247,227,.8)}
  @media(max-width:760px){.memory-journal__layout{grid-template-columns:1fr}.memory-journal__row{grid-template-columns:1fr}}
</style>
