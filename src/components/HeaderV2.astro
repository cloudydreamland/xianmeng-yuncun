---
import RealmOracleSigil from './RealmOracleSigil.astro';

const pathname = Astro.url.pathname;
const realms = [
  ['/world/cloud-village/', '云村', 'cloud-village'],
  ['/world/rain-bridge/', '雨桥', 'rain-bridge'],
  ['/world/star-abyss/', '星渊', 'star-abyss'],
  ['/world/wind-valley/', '风谷', 'wind-valley'],
  ['/world/moon-pool/', '月潭', 'moon-pool'],
  ['/world/snow-cliff/', '雪崖', 'snow-cliff'],
  ['/world/lantern-lane/', '浮屿·灯巷', 'lantern-lane'],
] as const;
const active = (href: string) => pathname.startsWith(href);
const realmActive = realms.some(([href]) => active(href));
---
<header class="site-header">
  <a class="site-brand" href="/" aria-label="闲梦world首页"><span class="site-brand__mark" aria-hidden="true">闲</span><span><strong>闲梦world</strong><small>七境个人数字世界</small></span></a>
  <nav class="desktop-nav pixel-hud" aria-label="主导航">
    <a href="/" class:list={[{ active: pathname === '/' }]}>首页</a>
    <a href="/world/wind-valley/" class:list={[{ active: active('/world/wind-valley/') }]}>笔记</a>
    <a href="/learn/" class:list={[{ active: active('/learn/') || active('/interview/') }]}>学习</a>
    <a href="/world/moon-pool/" class:list={[{ active: active('/world/moon-pool/') }]}>项目</a>
    <a href="/about" class:list={[{ active: active('/about') }]}>关于</a>
    <details class:list={['desktop-realm-menu', { active: realmActive }]}>
      <summary><RealmOracleSigil realm="cloud-village" size={19} /><span>七境</span><span aria-hidden="true">⌄</span></summary>
      <div class="desktop-realm-menu__panel">
        {realms.map(([href, label, realm]) => <a class="realm-nav-link" href={href} aria-label={`前往${label}`} class:list={[{ active: active(href) }]}><RealmOracleSigil realm={realm} size={21} /><span>{label}</span></a>)}
      </div>
    </details>
    <a href="/workspace/" class:list={['nav-workspace', { active: active('/workspace/') }]}>工作台</a>
    <button type="button" class="nav-search" data-search-open aria-label="搜索云村内容"><span aria-hidden="true">⌕</span><span>云镜</span><kbd>⌘K</kbd></button>
  </nav>
  <details class="mobile-nav">
    <summary aria-label="打开导航"><span></span><span></span><span></span></summary>
    <nav aria-label="移动端导航">
      <div class="mobile-nav__primary">
        <a href="/">首页</a>
        <a href="/world/wind-valley/">笔记</a>
        <a href="/learn/">学习</a>
        <a href="/world/moon-pool/">项目</a>
        <a href="/about">关于</a>
      </div>
      <details class="mobile-nav__realm-group">
        <summary><span><strong>七境</strong><small>按世界境域浏览</small></span><em aria-hidden="true">＋</em></summary>
        <div>{realms.map(([href, label, realm]) => <a class="realm-nav-link" href={href}><RealmOracleSigil realm={realm} size={22} /><span>{label}</span><small>境域入口</small></a>)}</div>
      </details>
      <a class="mobile-nav__workspace" href="/workspace/"><span aria-hidden="true">案</span><span><strong>工作台</strong><small>今日、收集、专注与生活工具</small></span><em aria-hidden="true">→</em></a>
      <div class="mobile-nav__utilities" aria-label="快捷工具">
        <button type="button" class="mobile-search" data-search-open>⌕ 云镜搜索</button>
        <button type="button" class="mobile-reading-list" data-reading-list-open>▤ 稍后阅读 <strong data-reading-list-count>0</strong></button>
        <button type="button" class="mobile-reading-list" data-reminder-open>铃 提醒中心</button>
      </div>
    </nav>
  </details>
</header>

<script>
  document.querySelectorAll<HTMLElement>('.mobile-nav [data-search-open], .mobile-nav [data-reading-list-open], .mobile-nav [data-reminder-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const menu = button.closest<HTMLDetailsElement>('.mobile-nav');
      if (menu) menu.open = false;
    });
  });
</script>
