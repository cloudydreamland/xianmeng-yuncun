<section class="life-insights life-panel" id="insights" aria-labelledby="life-insights-title" data-life-insights data-pagefind-ignore>
  <header class="life-panel__heading"><div><p class="pixel-kicker">CLOUD VILLAGE · 趋势</p><h2 id="life-insights-title">看见生活正在往哪里走。</h2><p>只做温和的七日与月度回望：完成、专注、习惯与开销，不设排名，也不制造压力。</p></div></header>
  <div class="life-insights__metrics"><article><span>七日完成</span><strong data-insight-tasks>0</strong><small>项日程</small></article><article><span>七日专注</span><strong data-insight-focus>0</strong><small>分钟</small></article><article><span>习惯完成率</span><strong data-insight-habits>0%</strong><small>最近七天</small></article><article><span>本月支出</span><strong data-insight-expense>¥0</strong><small data-insight-expense-change>暂无上月对比</small></article></div>
  <div class="life-insights__charts"><section><h3>七日节律</h3><div class="life-insights__bars" data-insight-bars></div></section><section><h3>本月去向</h3><div class="life-insights__categories" data-insight-categories></div><p data-insight-categories-empty>本月还没有账目。</p></section></div>
</section>

<script>
  import { LIFE_KEYS,LIFE_UPDATED_EVENT,localDateKey,readStored } from '../utils/lifeStore';
  const root=document.querySelector<HTMLElement>('[data-life-insights]');
  if(root){
    const dayKey=(offset:number)=>{const date=new Date();date.setDate(date.getDate()+offset);return localDateKey(date);};
    const render=()=>{const days=Array.from({length:7},(_,index)=>dayKey(index-6)),plans=readStored<any[]>(localStorage,LIFE_KEYS.plans,[]),focus=readStored<any[]>(localStorage,LIFE_KEYS.focusLog,[]),habits=readStored<any[]>(localStorage,LIFE_KEYS.habits,[]).filter((item)=>item&&!item.archived),habitLog=readStored<Record<string,string[]>>(localStorage,LIFE_KEYS.habitLog,{}),expenses=readStored<any[]>(localStorage,LIFE_KEYS.expenses,[]);const done=plans.filter((item)=>item.completedAt&&days.includes(String(item.completedAt).slice(0,10))).length;const minutes=focus.filter((item)=>days.includes(String(item.date||item.completedAt||'').slice(0,10))).reduce((sum,item)=>sum+Number(item.minutes||item.duration||0),0);const habitPossible=habits.length*7,habitDone=days.reduce((sum,day)=>sum+(habitLog[day]||[]).filter((id)=>habits.some((habit)=>habit.id===id)).length,0);const month=localDateKey().slice(0,7),previousDate=new Date();previousDate.setMonth(previousDate.getMonth()-1);const previous=localDateKey(previousDate).slice(0,7),monthItems=expenses.filter((item)=>String(item.date).startsWith(month)),monthTotal=monthItems.reduce((sum,item)=>sum+Number(item.amount||0),0),previousTotal=expenses.filter((item)=>String(item.date).startsWith(previous)).reduce((sum,item)=>sum+Number(item.amount||0),0);const set=(selector:string,value:string|number)=>{const node=root.querySelector(selector);if(node)node.textContent=String(value);};set('[data-insight-tasks]',done);set('[data-insight-focus]',Math.round(minutes));set('[data-insight-habits]',`${habitPossible?Math.round(habitDone/habitPossible*100):0}%`);set('[data-insight-expense]',`¥${monthTotal.toFixed(0)}`);set('[data-insight-expense-change]',previousTotal?`较上月 ${monthTotal>previousTotal?'＋':'－'}${Math.abs((monthTotal-previousTotal)/previousTotal*100).toFixed(0)}%`:'暂无上月对比');const daily=days.map((day)=>({day,value:(habitLog[day]||[]).length+focus.filter((item)=>String(item.date||item.completedAt||'').startsWith(day)).reduce((sum,item)=>sum+Number(item.minutes||item.duration||0)/25,0)+plans.filter((item)=>String(item.completedAt||'').startsWith(day)).length})),max=Math.max(1,...daily.map((item)=>item.value));root.querySelector('[data-insight-bars]')?.replaceChildren(...daily.map((item)=>{const column=document.createElement('div'),bar=document.createElement('i'),label=document.createElement('span');bar.style.height=`${Math.max(4,item.value/max*100)}%`;bar.title=`${item.day} · 活跃度 ${item.value.toFixed(1)}`;label.textContent=new Intl.DateTimeFormat('zh-CN',{weekday:'short'}).format(new Date(`${item.day}T12:00:00`));column.append(bar,label);return column;}));const byCategory=new Map<string,number>();monthItems.forEach((item)=>byCategory.set(item.category||'其他',(byCategory.get(item.category||'其他')||0)+Number(item.amount||0)));const categories=[...byCategory].sort((a,b)=>b[1]-a[1]);root.querySelector('[data-insight-categories]')?.replaceChildren(...categories.map(([name,value])=>{const row=document.createElement('div'),label=document.createElement('span'),track=document.createElement('i'),fill=document.createElement('b'),amount=document.createElement('strong');label.textContent=name;fill.style.width=`${monthTotal?value/monthTotal*100:0}%`;track.append(fill);amount.textContent=`¥${value.toFixed(0)}`;row.append(label,track,amount);return row;}));const empty=root.querySelector<HTMLElement>('[data-insight-categories-empty]');if(empty)empty.hidden=categories.length>0;};render();window.addEventListener(LIFE_UPDATED_EVENT,render);window.addEventListener('yuncun-local-plans-updated',render);window.addEventListener('storage',render);
  }
</script>

<style>
  .life-insights{border-color:#6c7f6d;background:rgba(247,245,220,.96)}.life-insights__metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:24px}.life-insights__metrics article{display:grid;gap:4px;padding:17px;border:2px solid #839083;background:#fffbe8}.life-insights__metrics span,.life-insights__metrics small{color:#758078;font-size:.64rem}.life-insights__metrics strong{color:#456151;font-family:var(--serif);font-size:1.7rem}.life-insights__charts{display:grid;grid-template-columns:1.2fr 1fr;gap:20px;margin-top:20px}.life-insights__charts>section{padding:18px;border:2px solid #849187;background:#f5f3dd}.life-insights__charts h3{margin:0 0 15px;color:#476052;font-family:var(--serif)}.life-insights__bars{display:grid;grid-template-columns:repeat(7,1fr);align-items:end;height:150px;gap:8px}.life-insights__bars div{display:grid;grid-template-rows:1fr auto;align-items:end;height:100%;gap:5px;text-align:center}.life-insights__bars i{display:block;min-height:4px;background:#5f826c}.life-insights__bars span{color:#748078;font-size:.58rem}.life-insights__categories{display:grid;gap:9px}.life-insights__categories div{display:grid;grid-template-columns:56px 1fr 60px;align-items:center;gap:7px;font-size:.65rem}.life-insights__categories i{height:8px;background:#dce2d2}.life-insights__categories b{display:block;height:100%;background:#6a8974}.life-insights__categories strong{text-align:right;color:#536b5d}@media(max-width:760px){.life-insights__metrics{grid-template-columns:1fr 1fr}.life-insights__charts{grid-template-columns:1fr}}
</style>
