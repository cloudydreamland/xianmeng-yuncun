<section class="today-dashboard life-panel" id="today" aria-labelledby="today-dashboard-title" data-today-dashboard data-pagefind-ignore>
  <header class="life-panel__heading"><div><p class="pixel-kicker">CLOUD VILLAGE · 今日</p><h2 id="today-dashboard-title">今日概览</h2><p>汇总今日重点、临期事项、习惯和待整理记录。</p></div><time data-today-date></time></header>
  <div class="today-dashboard__focus"><span>今日重点</span><strong data-today-focus>尚未填写</strong><button type="button" data-quick-capture-open data-capture-kind="task">＋ 新增任务</button></div>
  <div class="today-dashboard__metrics">
    <a href="/workspace/"><strong data-today-task-count>0</strong><span>今日任务</span></a>
    <a href="/world/rain-bridge/#inbox"><strong data-today-inbox-count>0</strong><span>待整理记录</span></a>
    <a href="/world/snow-cliff/#habits"><strong data-today-habit-count>0/0</strong><span>今日习惯</span></a>
    <a href="/world/moon-pool/#expiries"><strong data-today-expiry-count>0</strong><span>三十日内到期</span></a>
  </div>
  <div class="today-dashboard__columns">
    <section><h3>今日任务</h3><ol data-today-tasks></ol><p data-today-tasks-empty>今天没有必须完成的事项。</p></section>
    <section><h3>快捷操作</h3><div class="today-dashboard__actions"><button type="button" data-quick-capture-open data-capture-kind="idea">记录灵感</button><a href="/world/star-abyss/#focus">开始专注</a><a href="/world/snow-cliff/#habits">习惯打卡</a><button type="button" data-quick-capture-open data-capture-kind="journal">记录手记</button></div></section>
  </div>
</section>

<script>
  import { LIFE_KEYS, LIFE_UPDATED_EVENT, localDateKey, readStored } from '../utils/lifeStore';
  const root = document.querySelector<HTMLElement>('[data-today-dashboard]');
  if (root) {
    const set = (selector: string, text: string | number) => { const node = root.querySelector(selector); if (node) node.textContent = String(text); };
    const render = () => {
      const today = localDateKey(); const now = Date.now(); const month = now + 30 * 86_400_000;
      const plans = readStored<any[]>(localStorage, LIFE_KEYS.plans, []).filter((item) => item && !item.completed);
      const todayPlans = plans.filter((item) => item.date === today);
      const inbox = readStored<any[]>(localStorage, LIFE_KEYS.inbox, []).filter((item) => item && !item.handled);
      const habits = readStored<any[]>(localStorage, LIFE_KEYS.habits, []).filter((item) => item && !item.archived);
      const habitLog = readStored<Record<string,string[]>>(localStorage, LIFE_KEYS.habitLog, {});
      const doneHabits = habitLog[today] || [];
      const expiries = readStored<any[]>(localStorage, LIFE_KEYS.expiries, []).filter((item) => item && !item.completed && item.date && Date.parse(`${item.date}T23:59:59`) <= month);
      const focus = readStored<any>(localStorage, LIFE_KEYS.focus, null);
      set('[data-today-task-count]', todayPlans.length); set('[data-today-inbox-count]', inbox.length); set('[data-today-habit-count]', `${doneHabits.filter((id) => habits.some((habit) => habit.id === id)).length}/${habits.length}`); set('[data-today-expiry-count]', expiries.length);
      set('[data-today-focus]', focus?.date === today && focus.title ? focus.title : todayPlans[0]?.title || '尚未填写');
      const list = root.querySelector<HTMLOListElement>('[data-today-tasks]'); const empty = root.querySelector<HTMLElement>('[data-today-tasks-empty]');
      list?.replaceChildren(...todayPlans.slice(0, 5).map((plan) => { const li = document.createElement('li'); const strong = document.createElement('strong'); strong.textContent = plan.title; const span = document.createElement('span'); span.textContent = plan.priority === 'high' ? '高优先' : '今日'; li.append(strong, span); return li; }));
      if (empty) empty.hidden = todayPlans.length > 0;
      const date = root.querySelector<HTMLTimeElement>('[data-today-date]'); if (date) { date.dateTime = today; date.textContent = new Intl.DateTimeFormat('zh-CN',{month:'long',day:'numeric',weekday:'long'}).format(new Date()); }
    };
    render(); window.addEventListener('storage', render); window.addEventListener(LIFE_UPDATED_EVENT, render); window.addEventListener('yuncun-local-plans-updated', render);
  }
</script>

<style>
  .life-panel { margin-top:58px; padding:clamp(20px,4vw,34px); border:3px solid #60776a; color:#45574f; background:rgba(248,247,225,.95); box-shadow:8px 8px 0 rgba(37,61,51,.22); }
  .life-panel__heading { display:flex; align-items:end; justify-content:space-between; gap:24px; }
  .life-panel__heading h2 { margin:0; color:#3e5d50; font-family:var(--serif); font-size:clamp(2rem,4vw,3.4rem); }
  .life-panel__heading p:last-child { margin-bottom:0; color:#64736b; line-height:1.75; }
  .life-panel__heading time { color:#65786d; font-size:.72rem; }
  .today-dashboard__focus { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:14px; margin-top:26px; padding:18px; border:2px solid #7d8c7e; background:#fff9de; }
  .today-dashboard__focus span { color:#77847b; font-size:.68rem; font-weight:900; }
  .today-dashboard__focus strong { color:#485a50; font-family:var(--serif); font-size:1.15rem; }
  .today-dashboard button,.today-dashboard__actions a { padding:9px 12px; border:2px solid #66796d; color:#40594e; background:#edf0d5; cursor:pointer; font:inherit; font-size:.7rem; font-weight:900; text-align:center; }
  .today-dashboard__metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-top:15px; }
  .today-dashboard__metrics a { display:grid; gap:4px; padding:16px; border:2px solid #879389; color:#53665c; background:#f6f2d9; }
  .today-dashboard__metrics strong { font-family:var(--serif); font-size:1.65rem; }
  .today-dashboard__metrics span { color:#718078; font-size:.65rem; }
  .today-dashboard__columns { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:22px; }
  .today-dashboard__columns h3 { color:#485d52; font-family:var(--serif); }
  .today-dashboard__columns ol { display:grid; gap:7px; padding:0; list-style:none; }
  .today-dashboard__columns li { display:flex; justify-content:space-between; gap:12px; padding:10px 12px; border-left:4px solid #77917e; background:#fffbea; }
  .today-dashboard__columns li span,.today-dashboard__columns p { color:#758078; font-size:.68rem; }
  .today-dashboard__actions { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  @media(max-width:700px){ .life-panel__heading { align-items:start; flex-direction:column; } .today-dashboard__metrics { grid-template-columns:1fr 1fr; } .today-dashboard__columns { grid-template-columns:1fr; } .today-dashboard__focus { grid-template-columns:1fr; } }
</style>
