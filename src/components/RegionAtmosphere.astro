---
interface Props {
  theme: 'village' | 'wind' | 'star' | 'moon' | 'rain' | 'snow' | 'lantern';
}

const { theme } = Astro.props;

const particles = (count: number, seed = 0) => Array.from({ length: count }, (_, index) => {
  const value = index + seed;
  return {
    x: (value * 37 + 11) % 101,
    y: (value * 61 + 7) % 101,
    delay: -((value * 1.37) % 18),
    duration: 7 + ((value * 29) % 13),
    size: 3 + ((value * 17) % 8),
    drift: -38 + ((value * 23) % 77),
    driftBack: Math.round((38 - ((value * 23) % 77)) * .5),
    snowReturn: Math.round((38 - ((value * 23) % 77)) * .35),
    basin: (value * 61 + 7) % 38,
    rainDuration: (1.1 + ((value * 7) % 8) / 10).toFixed(1),
    rippleDuration: (3.2 + ((value * 11) % 28) / 10).toFixed(1),
    pulseDuration: (3.5 + ((value * 13) % 45) / 10).toFixed(1),
    longDuration: (12 + ((value * 17) % 100) / 10).toFixed(1),
    mediumDuration: (5 + ((value * 19) % 70) / 10).toFixed(1),
  };
});

const styleFor = (particle: ReturnType<typeof particles>[number]) =>
  `--x:${particle.x};--y:${particle.y};--basin:${particle.basin};--delay:${particle.delay}s;--duration:${particle.duration}s;--rain-duration:${particle.rainDuration}s;--ripple-duration:${particle.rippleDuration}s;--pulse-duration:${particle.pulseDuration}s;--long-duration:${particle.longDuration}s;--medium-duration:${particle.mediumDuration}s;--size:${particle.size}px;--drift:${particle.drift}px;--drift-back:${particle.driftBack}px;--snow-return:${particle.snowReturn}px`;

const primary = particles(theme === 'rain' || theme === 'snow' ? 34 : 22);
const secondary = particles(theme === 'star' || theme === 'lantern' ? 12 : 9, 41);
---

<div class:list={['region-atmosphere', `region-atmosphere--${theme}`]} aria-hidden="true">
  <div class="region-atmosphere__wash"></div>

  {theme === 'village' && (
    <>
      <div class="village-sun"></div>
      <div class="village-river"></div>
      <div class="village-cloud village-cloud--one"></div>
      <div class="village-cloud village-cloud--two"></div>
      {primary.map((particle) => <i class="pollen" style={styleFor(particle)}></i>)}
    </>
  )}

  {theme === 'rain' && (
    <>
      <div class="rain-curtain rain-curtain--one"></div>
      <div class="rain-curtain rain-curtain--two"></div>
      <div class="rain-thunder"></div>
      <div class="rain-mist"></div>
      {primary.map((particle) => <i class="rain-drop" style={styleFor(particle)}></i>)}
      {secondary.map((particle) => <i class="rain-ring" style={styleFor(particle)}></i>)}
    </>
  )}

  {theme === 'star' && (
    <>
      <div class="star-nebula"></div>
      <div class="star-orbit star-orbit--one"></div>
      <div class="star-orbit star-orbit--two"></div>
      {primary.map((particle) => <i class="star-dust" style={styleFor(particle)}></i>)}
      {secondary.slice(0, 3).map((particle) => <i class="meteor" style={styleFor(particle)}></i>)}
    </>
  )}

  {theme === 'wind' && (
    <>
      <div class="wind-vortex"></div>
      <div class="wind-gust wind-gust--one"></div>
      <div class="wind-gust wind-gust--two"></div>
      <div class="wind-current wind-current--one"></div>
      <div class="wind-current wind-current--two"></div>
      {primary.map((particle) => <i class="wind-leaf" style={styleFor(particle)}></i>)}
    </>
  )}

  {theme === 'moon' && (
    <>
      <div class="moon-disc"></div>
      <div class="moon-reflection"></div>
      <div class="moon-halo"></div>
      {primary.map((particle) => <i class="moon-glint" style={styleFor(particle)}></i>)}
      {secondary.map((particle) => <i class="moon-ripple" style={styleFor(particle)}></i>)}
    </>
  )}

  {theme === 'snow' && (
    <>
      <div class="snow-aurora"></div>
      <div class="snow-mountain"></div>
      <div class="snow-haze"></div>
      {primary.map((particle) => <i class="snow-flake" style={styleFor(particle)}></i>)}
    </>
  )}

  {theme === 'lantern' && (
    <>
      <div class="lantern-giant lantern-giant--one"><span></span></div>
      <div class="lantern-giant lantern-giant--two"><span></span></div>
      <div class="lantern-street"></div>
      <div class="lantern-glow lantern-glow--one"></div>
      <div class="lantern-glow lantern-glow--two"></div>
      {primary.map((particle) => <i class="firefly" style={styleFor(particle)}></i>)}
      {secondary.map((particle) => <i class="ember" style={styleFor(particle)}></i>)}
    </>
  )}
</div>

<style>
  .region-atmosphere {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }

  .region-atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .32;
    background: linear-gradient(90deg, rgba(8, 22, 30, .2), transparent 28%, transparent 70%, rgba(8, 22, 30, .18));
  }

  .region-atmosphere__wash {
    position: absolute;
    inset: 0;
    opacity: .76;
  }

  .region-atmosphere--village .region-atmosphere__wash {
    background: radial-gradient(circle at 18% 18%, rgba(255, 249, 184, .56), transparent 34%), linear-gradient(180deg, rgba(150, 213, 191, .28), transparent 60%);
  }

  .village-sun {
    position: absolute;
    top: 7vh;
    left: 8vw;
    width: clamp(170px, 24vw, 390px);
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: .3;
    background: radial-gradient(circle, rgba(255, 248, 196, .92) 0 17%, rgba(255, 224, 120, .35) 34%, transparent 68%);
    filter: blur(2px);
    animation: village-dawn 9s ease-in-out infinite;
  }

  .village-river {
    position: absolute;
    right: -10%;
    bottom: -9%;
    left: -10%;
    height: 34%;
    opacity: .24;
    background: repeating-linear-gradient(174deg, transparent 0 21px, rgba(224, 252, 235, .65) 22px 24px, transparent 25px 43px);
    filter: blur(.4px);
    transform: perspective(420px) rotateX(58deg);
    animation: river-flow 10s linear infinite;
  }

  .village-cloud {
    position: absolute;
    width: 34vw;
    height: 12vw;
    min-height: 90px;
    opacity: .25;
    filter: blur(15px);
    border-radius: 50%;
    background: #fffdf0;
    box-shadow: 9vw -2vw 0 #fffdf0, 18vw 1vw 0 rgba(255, 253, 240, .8);
    animation: cloud-wander 36s ease-in-out infinite alternate;
  }

  .village-cloud--one { top: 13%; left: -24%; }
  .village-cloud--two { right: -20%; bottom: 8%; animation-delay: -17s; animation-direction: alternate-reverse; }

  .pollen,
  .star-dust,
  .moon-glint,
  .firefly,
  .ember,
  .snow-flake,
  .wind-leaf,
  .rain-drop,
  .rain-ring,
  .moon-ripple,
  .meteor {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    display: block;
  }

  .pollen {
    width: var(--size);
    height: var(--size);
    opacity: .28;
    border-radius: 50%;
    background: #fff4aa;
    box-shadow: 0 0 9px rgba(255, 240, 153, .65);
    animation: mote-rise var(--duration) ease-in-out var(--delay) infinite;
  }

  .region-atmosphere--rain .region-atmosphere__wash {
    background: linear-gradient(115deg, rgba(35, 75, 96, .46), transparent 47%), linear-gradient(180deg, rgba(45, 74, 95, .35), rgba(99, 145, 153, .2));
  }

  .rain-curtain {
    position: absolute;
    inset: -35% -25%;
    opacity: .4;
    background: repeating-linear-gradient(102deg, transparent 0 13px, rgba(202, 237, 241, .44) 14px 16px, transparent 17px 29px);
    filter: blur(.35px);
    animation: rain-curtain .75s linear infinite;
  }

  .rain-curtain--two { opacity: .18; background-size: 44px 44px; animation-duration: 1.35s; transform: scale(1.2); }

  .rain-thunder {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(circle at 75% 10%, rgba(236, 249, 255, .88), transparent 42%);
    mix-blend-mode: screen;
    animation: thunder-flash 11s steps(1, end) infinite;
  }

  .rain-mist {
    position: absolute;
    inset: 45% -15% auto;
    height: 28%;
    opacity: .32;
    filter: blur(24px);
    background: linear-gradient(90deg, transparent, #eaf5ed 30%, #eaf5ed 70%, transparent);
    animation: mist-breathe 12s ease-in-out infinite;
  }

  .rain-drop {
    width: 2px;
    height: calc(var(--size) * 5.6);
    opacity: .58;
    background: linear-gradient(180deg, transparent, rgba(196, 235, 239, .92));
    transform: rotate(12deg);
    animation: rain-fall var(--rain-duration) linear var(--delay) infinite;
  }

  .rain-ring {
    top: auto;
    bottom: calc(var(--basin) * 1%);
    width: calc(var(--size) * 4);
    height: calc(var(--size) * 1.15);
    opacity: 0;
    border: 1px solid rgba(190, 232, 231, .62);
    border-radius: 50%;
    animation: rain-ripple var(--ripple-duration) ease-out var(--delay) infinite;
  }

  .region-atmosphere--star .region-atmosphere__wash {
    background: radial-gradient(circle at 72% 14%, rgba(124, 103, 209, .48), transparent 31%), linear-gradient(180deg, rgba(5, 12, 38, .62), rgba(18, 27, 65, .3));
  }

  .star-nebula {
    position: absolute;
    top: -25%;
    left: 12%;
    width: 78vw;
    height: 110vh;
    opacity: .38;
    border-radius: 50%;
    background: radial-gradient(ellipse at 45% 48%, rgba(105, 189, 224, .52), transparent 15%), radial-gradient(ellipse at 58% 40%, rgba(169, 106, 225, .55), transparent 29%), radial-gradient(ellipse at 37% 63%, rgba(68, 76, 181, .46), transparent 37%);
    filter: blur(32px);
    animation: nebula-turn 32s ease-in-out infinite alternate;
  }

  .star-orbit {
    position: absolute;
    top: 12%;
    right: -12%;
    width: 72vw;
    height: 42vw;
    opacity: .28;
    border: 2px solid rgba(181, 215, 255, .5);
    border-right-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    transform: rotate(-23deg);
    box-shadow: inset 0 0 34px rgba(139, 129, 232, .18);
    animation: orbit-drift 18s ease-in-out infinite alternate;
  }

  .star-orbit--two { top: 31%; right: -24%; opacity: .18; transform: rotate(-16deg) scale(.72); animation-delay: -7s; }

  .star-dust {
    width: max(2px, calc(var(--size) * .42));
    height: max(2px, calc(var(--size) * .42));
    border-radius: 50%;
    background: #eef5ff;
    box-shadow: 0 0 calc(var(--size) * 1.5) rgba(167, 204, 255, .9);
    animation: star-pulse var(--pulse-duration) ease-in-out var(--delay) infinite;
  }

  .meteor {
    width: clamp(140px, 20vw, 340px);
    height: 2px;
    opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(222, 237, 255, .9));
    transform: rotate(-32deg);
    animation: meteor-cross var(--long-duration) ease-in var(--delay) infinite;
  }

  .region-atmosphere--wind .region-atmosphere__wash {
    background: radial-gradient(circle at 12% 35%, rgba(199, 231, 175, .44), transparent 30%), linear-gradient(135deg, rgba(48, 123, 98, .32), transparent 60%);
  }

  .wind-vortex {
    position: absolute;
    top: 9%;
    right: -18vw;
    width: 78vw;
    height: 78vw;
    opacity: .24;
    border: clamp(20px, 4vw, 68px) double rgba(226, 245, 207, .5);
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    filter: blur(4px);
    animation: vortex-turn 22s linear infinite;
  }

  .wind-gust {
    position: absolute;
    left: -30%;
    width: 88%;
    height: 22%;
    opacity: .24;
    border-top: 7px double rgba(230, 248, 209, .64);
    border-radius: 50%;
    filter: blur(1px);
    animation: gust-cross 7s ease-in-out infinite;
  }

  .wind-gust--one { top: 22%; }
  .wind-gust--two { top: 62%; animation-delay: -3.5s; transform: scale(.75) rotate(4deg); }

  .wind-current {
    position: absolute;
    left: -20%;
    width: 62%;
    height: 15%;
    opacity: .28;
    border-top: 3px solid #e8f3d4;
    border-radius: 50%;
    filter: blur(.2px);
    animation: wind-sweep 12s ease-in-out infinite;
  }

  .wind-current--one { top: 23%; }
  .wind-current--two { top: 68%; animation-delay: -5s; transform: scaleX(.7); }

  .wind-leaf {
    width: calc(var(--size) * 1.2);
    height: calc(var(--size) * .68);
    opacity: .38;
    border-radius: 90% 12% 90% 12%;
    background: #a7c680;
    box-shadow: 0 0 0 1px rgba(67, 101, 68, .16);
    animation: leaf-flight var(--duration) cubic-bezier(.38, 0, .62, 1) var(--delay) infinite;
  }

  .region-atmosphere--moon .region-atmosphere__wash {
    background: radial-gradient(circle at 82% 9%, rgba(237, 239, 216, .5), transparent 25%), linear-gradient(180deg, rgba(40, 65, 111, .44), rgba(75, 147, 149, .18));
  }

  .moon-disc {
    position: absolute;
    top: -10vw;
    right: 4vw;
    width: clamp(260px, 38vw, 610px);
    aspect-ratio: 1;
    opacity: .42;
    border-radius: 50%;
    background: radial-gradient(circle at 43% 42%, rgba(224, 226, 195, .32) 0 4%, transparent 5%), radial-gradient(circle at 61% 58%, rgba(199, 205, 183, .24) 0 7%, transparent 8%), #fffbdc;
    box-shadow: 0 0 70px rgba(241, 244, 205, .62), 0 0 180px rgba(175, 213, 215, .38);
    animation: moon-breathe 10s ease-in-out infinite;
  }

  .moon-reflection {
    position: absolute;
    top: 34%;
    right: 2%;
    width: 42vw;
    height: 76%;
    opacity: .3;
    background: repeating-linear-gradient(177deg, rgba(248, 244, 205, .7) 0 2px, transparent 3px 17px);
    clip-path: polygon(38% 0, 62% 0, 100% 100%, 0 100%);
    filter: blur(1px);
    animation: reflection-shimmer 8s ease-in-out infinite;
  }

  .moon-halo {
    position: absolute;
    top: -8vw;
    right: 4vw;
    width: 28vw;
    height: 28vw;
    opacity: .13;
    border-radius: 50%;
    background: #fffbd9;
    filter: blur(30px);
    animation: halo-breathe 8s ease-in-out infinite;
  }

  .moon-glint {
    top: auto;
    bottom: calc(var(--y) * .65%);
    width: calc(var(--size) * 3.2);
    height: 1px;
    opacity: .25;
    background: linear-gradient(90deg, transparent, #f5f2ce, transparent);
    animation: water-glint var(--duration) ease-in-out var(--delay) infinite;
  }

  .moon-ripple {
    top: auto;
    bottom: calc(var(--y) * .48%);
    width: calc(var(--size) * 6);
    height: calc(var(--size) * 1.25);
    opacity: 0;
    border: 1px solid rgba(229, 241, 222, .42);
    border-radius: 50%;
    animation: moon-ripple var(--medium-duration) ease-out var(--delay) infinite;
  }

  .region-atmosphere--snow .region-atmosphere__wash {
    background: linear-gradient(150deg, rgba(222, 235, 239, .42), transparent 48%), linear-gradient(180deg, rgba(51, 76, 105, .42), rgba(203, 225, 225, .18));
  }

  .snow-aurora {
    position: absolute;
    top: -12%;
    left: -15%;
    width: 130%;
    height: 56%;
    opacity: .23;
    background: linear-gradient(112deg, transparent 15%, rgba(139, 229, 207, .62) 32%, rgba(150, 181, 240, .42) 48%, rgba(209, 165, 236, .34) 62%, transparent 77%);
    filter: blur(28px);
    transform: skewY(-8deg);
    animation: aurora-wave 13s ease-in-out infinite alternate;
  }

  .snow-mountain {
    position: absolute;
    right: -12%;
    bottom: -16%;
    width: 68%;
    height: 70%;
    opacity: .2;
    background: linear-gradient(145deg, transparent 49%, rgba(233, 241, 239, .8) 50% 58%, rgba(81, 107, 126, .55) 59%);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    filter: blur(1px);
  }

  .snow-haze {
    position: absolute;
    inset: auto -10% 4%;
    height: 24%;
    opacity: .14;
    filter: blur(30px);
    background: #f7faf2;
  }

  .snow-flake {
    width: var(--size);
    height: var(--size);
    opacity: calc(.42 + var(--size) * .025);
    border-radius: 50%;
    background: #f8fbf4;
    box-shadow: 0 0 calc(var(--size) * .8) rgba(255, 255, 255, .55);
    animation: snow-fall var(--duration) linear var(--delay) infinite;
  }

  .region-atmosphere--lantern .region-atmosphere__wash {
    background: radial-gradient(circle at 14% 22%, rgba(255, 174, 78, .42), transparent 28%), linear-gradient(180deg, rgba(53, 25, 50, .46), rgba(111, 55, 30, .22));
  }

  .lantern-giant {
    position: absolute;
    width: clamp(78px, 9vw, 145px);
    height: clamp(105px, 13vw, 210px);
    opacity: .48;
    border: 4px solid rgba(255, 210, 129, .8);
    border-radius: 44% 44% 37% 37%;
    background: repeating-linear-gradient(90deg, transparent 0 17%, rgba(255, 224, 151, .2) 18% 21%), radial-gradient(circle, #ffd580, #dc7048 72%);
    box-shadow: 0 0 45px rgba(255, 144, 67, .64), inset 0 0 24px rgba(255, 238, 173, .62);
    animation: lantern-float 9s ease-in-out infinite;
  }

  .lantern-giant::before, .lantern-giant::after { content: ''; position: absolute; left: 15%; width: 70%; height: 6px; background: #6f3f35; box-shadow: 0 0 8px rgba(38, 20, 20, .4); }
  .lantern-giant::before { top: -7px; }
  .lantern-giant::after { bottom: -7px; }
  .lantern-giant span { position: absolute; top: 100%; left: 50%; width: 2px; height: 44px; background: #e7a94c; transform: translateX(-50%); }
  .lantern-giant--one { top: 12%; left: 5%; }
  .lantern-giant--two { right: 7%; bottom: 13%; width: clamp(58px, 7vw, 112px); height: clamp(82px, 10vw, 160px); animation-delay: -4.5s; }

  .lantern-street {
    position: absolute;
    inset: auto -8% -12%;
    height: 42%;
    opacity: .27;
    background: radial-gradient(circle at 10% 55%, #ffc45f 0 4px, transparent 5px), radial-gradient(circle at 30% 25%, #ffc45f 0 5px, transparent 6px), radial-gradient(circle at 54% 62%, #ffc45f 0 4px, transparent 5px), radial-gradient(circle at 77% 20%, #ffc45f 0 6px, transparent 7px), radial-gradient(circle at 92% 58%, #ffc45f 0 4px, transparent 5px), linear-gradient(170deg, transparent 46%, rgba(255, 149, 65, .45) 47% 48%, transparent 49%);
    filter: drop-shadow(0 0 12px #e89048);
    animation: street-glow 5s ease-in-out infinite;
  }

  .lantern-glow {
    position: absolute;
    width: 18vw;
    height: 18vw;
    opacity: .24;
    border-radius: 50%;
    filter: blur(24px);
    background: #ffb94f;
    animation: lantern-breathe 6s ease-in-out infinite;
  }

  .lantern-glow--one { top: 9%; left: -5%; }
  .lantern-glow--two { right: -4%; bottom: 10%; animation-delay: -3s; }

  .firefly {
    width: max(3px, calc(var(--size) * .58));
    height: max(3px, calc(var(--size) * .58));
    border-radius: 50%;
    background: #ffe27c;
    box-shadow: 0 0 calc(var(--size) * 1.7) #f7c75d;
    animation: firefly-drift var(--duration) ease-in-out var(--delay) infinite;
  }

  .ember {
    width: 2px;
    height: calc(var(--size) * .75);
    opacity: .35;
    border-radius: 50%;
    background: #ffad62;
    box-shadow: 0 0 7px #e87d42;
    animation: ember-rise var(--medium-duration) ease-out var(--delay) infinite;
  }

  @keyframes cloud-wander {
    to { transform: translate3d(48vw, 3vh, 0) scale(1.08); }
  }

  @keyframes village-dawn { 50% { opacity: .42; transform: scale(1.08); } }
  @keyframes river-flow { to { background-position: 120px 50px; } }

  @keyframes mote-rise {
    0%, 100% { opacity: .08; transform: translate3d(0, 25px, 0); }
    50% { opacity: .5; transform: translate3d(var(--drift), -45px, 0); }
  }

  @keyframes mist-breathe {
    50% { opacity: .26; transform: translateX(7%); }
  }

  @keyframes rain-fall {
    from { transform: translate3d(-14vw, -20vh, 0) rotate(12deg); }
    to { transform: translate3d(14vw, 115vh, 0) rotate(12deg); }
  }

  @keyframes rain-curtain { to { transform: translate3d(5vw, 18vh, 0); } }
  @keyframes thunder-flash { 0%, 72%, 74%, 76%, 100% { opacity: 0; } 73%, 75% { opacity: .72; } }

  @keyframes rain-ripple {
    0%, 72% { opacity: 0; transform: scale(.35); }
    78% { opacity: .42; }
    100% { opacity: 0; transform: scale(1.5); }
  }

  @keyframes star-pulse {
    0%, 100% { opacity: .18; transform: scale(.65); }
    50% { opacity: .8; transform: scale(1.15); }
  }

  @keyframes nebula-turn { to { transform: translate3d(6vw, 3vh, 0) rotate(7deg) scale(1.08); } }
  @keyframes orbit-drift { to { opacity: .42; transform: rotate(-17deg) translateX(-5vw); } }

  @keyframes meteor-cross {
    0%, 76% { opacity: 0; transform: translate3d(12vw, -10vh, 0) rotate(-32deg); }
    78% { opacity: .8; }
    87%, 100% { opacity: 0; transform: translate3d(-34vw, 34vh, 0) rotate(-32deg); }
  }

  @keyframes wind-sweep {
    0% { opacity: 0; transform: translateX(0) scaleX(.55); }
    35% { opacity: .16; }
    100% { opacity: 0; transform: translateX(120vw) scaleX(1); }
  }

  @keyframes vortex-turn { to { transform: rotate(360deg); } }
  @keyframes gust-cross { 0% { opacity: 0; transform: translateX(-20vw) scaleX(.5); } 38% { opacity: .35; } 100% { opacity: 0; transform: translateX(150vw) scaleX(1.15); } }

  @keyframes leaf-flight {
    from { transform: translate3d(-18vw, -5vh, 0) rotate(0deg); }
    45% { transform: translate3d(35vw, 8vh, 0) rotate(210deg); }
    to { transform: translate3d(112vw, 25vh, 0) rotate(520deg); }
  }

  @keyframes halo-breathe {
    50% { opacity: .2; transform: scale(1.06); }
  }

  @keyframes moon-breathe { 50% { opacity: .5; transform: scale(1.035); } }
