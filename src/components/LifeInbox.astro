<section class="life-inbox life-panel" id="inbox" aria-labelledby="life-inbox-title" data-life-inbox data-pagefind-ignore>
  <header class="life-panel__heading"><div><p class="pixel-kicker">RAIN BRIDGE · 收集</p><h2 id="life-inbox-title">临时记录</h2><p>保存尚未分类的想法，可标记处理、转为任务或删除。</p></div><button class="pixel-button pixel-button--primary" type="button" data-quick-capture-open data-capture-kind="idea">＋ 新增记录</button></header>
  <div class="life-inbox__filters" role="group" aria-label="筛选收集箱"><button class="active" type="button" data-inbox-filter="open">待整理</button><button type="button" data-inbox-filter="all">全部</button><span data-inbox-count>0 条</span></div>
  <div class="life-inbox__list" data-inbox-list></div>
  <p class="life-inbox__empty" data-inbox-empty>没有待整理的记录。</p>
</section>

<script>
  import { LIFE_KEYS, LIFE_UPDATED_EVENT, announceLifeUpdate, lifeId, readStored, writeStored } from '../utils/lifeStore';
  const root = document.querySelector<HTMLElement>('[data-life-inbox]');
  if (root) {
    let filter = 'open';
    const read = () => readStored<any[]>(localStorage,LIFE_KEYS.inbox,[]).filter((item) => item && typeof item.id === 'string');
    const save = (items:any[]) => { writeStored(localStorage,LIFE_KEYS.inbox,items); announceLifeUpdate('inbox'); };
    const render = () => {
      const all = read(); const shown = filter === 'open' ? all.filter((item) => !item.handled) : all;
      const list = root.querySelector<HTMLElement>('[data-inbox-list]'); const empty = root.querySelector<HTMLElement>('[data-inbox-empty]'); const count = root.querySelector<HTMLElement>('[data-inbox-count]');
      if (count) count.textContent = `${shown.length} 条`;
      list?.replaceChildren(...shown.map((item) => {
        const article=document.createElement('article'); article.className=item.handled?'is-handled':'';
        const header=document.createElement('header'); const meta=document.createElement('span'); meta.textContent=`${item.category || '日常'} · ${item.date || ''}`; const status=document.createElement('strong'); status.textContent=item.handled?'已处理':'待整理'; header.append(meta,status);
        const title=document.createElement('h3'); title.textContent=item.title; const detail=document.createElement('p'); detail.textContent=item.detail || '没有补充。';
        const footer=document.createElement('footer'); const toggle=document.createElement('button'); toggle.type='button'; toggle.textContent=item.handled?'重新打开':'标记处理'; toggle.addEventListener('click',()=>{ const now=read(); const target=now.find((entry)=>entry.id===item.id); if(target)target.handled=!target.handled; save(now); render(); });
        const task=document.createElement('button'); task.type='button'; task.textContent='转为任务'; task.addEventListener('click',()=>{ const plans=readStored<any[]>(localStorage,LIFE_KEYS.plans,[]); const now=new Date().toISOString(); plans.push({id:lifeId('plan'),title:item.title,date:item.date||'',priority:'medium',notes:item.detail||'',completed:false,createdAt:now,updatedAt:now}); writeStored(localStorage,LIFE_KEYS.plans,plans); const inbox=read(); const target=inbox.find((entry)=>entry.id===item.id); if(target)target.handled=true; save(inbox); window.dispatchEvent(new CustomEvent('yuncun-local-plans-updated')); render(); });
        const remove=document.createElement('button'); remove.type='button'; remove.textContent='删除'; remove.className='danger'; remove.addEventListener('click',()=>{ if(confirm('删除这条记录？')){save(read().filter((entry)=>entry.id!==item.id));render();} }); footer.append(toggle,task,remove); article.append(header,title,detail,footer); return article;
      }));
      if(empty)empty.hidden=shown.length>0;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-inbox-filter]').forEach((button)=>button.addEventListener('click',()=>{filter=button.dataset.inboxFilter||'open';root.querySelectorAll('[data-inbox-filter]').forEach((item)=>item.classList.toggle('active',item===button));render();}));
    render(); window.addEventListener(LIFE_UPDATED_EVENT,render); window.addEventListener('storage',render);
  }
</script>

<style>
  .life-inbox { margin-top:64px; padding:clamp(20px,4vw,34px); border:3px solid #4f7782; color:#3e5d63; background:rgba(242,252,253,.96); box-shadow:8px 8px 0 rgba(27,66,75,.23); }
  .life-inbox .life-panel__heading { display:flex; align-items:end; justify-content:space-between; gap:22px; }
  .life-inbox h2 { margin:0; color:#315f69; font-family:var(--serif); font-size:clamp(2rem,4vw,3.3rem); }
  .life-inbox .life-panel__heading p:last-child { color:#5d7376; line-height:1.75; }
  .life-inbox__filters { display:flex; align-items:center; gap:8px; margin:24px 0 14px; }
  .life-inbox__filters button { padding:7px 11px; border:2px solid #6f8b90; color:#42636a; background:#e5f1f0; cursor:pointer; font-weight:900; }
  .life-inbox__filters button.active { color:#fff; background:#4f7880; }
  .life-inbox__filters span { margin-left:auto; font-size:.68rem; }
  .life-inbox__list { display:grid; gap:10px; }
  .life-inbox__list article { padding:18px; border:2px solid #729096; background:#fffdf1; }
  .life-inbox__list article.is-handled { opacity:.62; }
  .life-inbox__list header { display:flex; justify-content:space-between; color:#75898b; font-size:.64rem; }
  .life-inbox__list h3 { margin:12px 0 5px; color:#3c5c62; font-family:var(--serif); }
  .life-inbox__list p { margin:0; color:#617477; white-space:pre-wrap; line-height:1.65; }
  .life-inbox__list footer { display:flex; gap:7px; margin-top:14px; }
  .life-inbox__list footer button { padding:6px 9px; border:1px solid #789096; color:#40636a; background:#e9f2ef; cursor:pointer; }
  .life-inbox__list footer .danger { margin-left:auto; color:#8a5043; }
  .life-inbox__empty { padding:28px; border:2px dashed #7e9698; text-align:center; }
  @media(max-width:650px){ .life-inbox .life-panel__heading { align-items:start; flex-direction:column; } .life-inbox__list footer { flex-wrap:wrap; } }
</style>
