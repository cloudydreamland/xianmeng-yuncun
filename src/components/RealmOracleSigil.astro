---
type RealmId = 'cloud-village' | 'rain-bridge' | 'star-abyss' | 'wind-valley' | 'moon-pool' | 'snow-cliff' | 'lantern-lane';

const { realm, size = 24 } = Astro.props as { realm: RealmId; size?: number };
---

<svg
  class="oracle-sigil"
  data-oracle-sigil={realm}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  {realm === 'cloud-village' && (
    <>
      <path d="M4 13.5c3.2-4.2 6.5-4.4 9.8-.5 2.6-5 6.2-5 9.1-.7 3.4-.2 5.1 1.5 5.1 4.1-2.4 2-5 2.5-7.8 1.6-2.3 3.7-5.5 3.9-8.1.5-3.2.6-5.8-.2-8.1-2.4" />
      <path d="M8.5 24.7c2.8-1.8 5.4-1.8 7.8.2 2.2-1.8 4.5-2 7-.6" />
    </>
  )}
  {realm === 'rain-bridge' && (
    <>
      <path d="M4 12c3.5-3.2 7.5-4.8 12-4.8S24.5 8.8 28 12M7 12.2h18" />
      <path d="M9.2 15.5l-1 3.3m7.8-3.3-1 4.5m8-4.5-1 3.3M4.5 25c4.2-4.8 7.9-4.8 11.5 0 3.6-4.8 7.3-4.8 11.5 0" />
    </>
  )}
  {realm === 'star-abyss' && (
    <>
      <path d="M16 3.5l2.2 8.4 6.4-4.2-4.2 6.6 8.1 1.7-8.1 2 4.2 6.3-6.4-4.1-2.2 8.3-2.1-8.3-6.5 4.1 4.3-6.3L3.5 16l8.2-1.7-4.3-6.6 6.5 4.2L16 3.5Z" />
      <circle cx="16" cy="16" r="2.2" />
    </>
  )}
  {realm === 'wind-valley' && (
    <>
      <path d="M4 11c4.8-4.4 10-4.4 15.5 0 2.4 1.9 5.4.9 5.4-1.4 0-1.7-1.4-2.6-3.4-2.1" />
      <path d="M3.5 17c6.3-3.1 12-2.9 17 .5 3.3 2.2 6.7.8 6.7-2.1" />
      <path d="M7 23c4.3-2 8.1-1.6 11.3 1.2 2.1 1.8 4.9 1.1 5-1" />
    </>
  )}
  {realm === 'moon-pool' && (
    <>
      <path d="M20.8 4.2c-6.5 1.4-10 6.7-8.8 12.2 1.1 5 5.7 8 10.8 7.2-2.6 2.2-6 3-9.4 2.2C7.5 24.4 3.8 18.6 5.2 12.9 6.8 6.7 13.5 3 20.8 4.2Z" />
      <path d="M11 28c3.4-1.5 6.7-1.5 10 0" />
    </>
  )}
  {realm === 'snow-cliff' && (
    <>
      <path d="M16 3v18M8.2 7.5l15.6 9M23.8 7.5l-15.6 9M12.5 5.2 16 8.6l3.5-3.4M9 11.2l1.2 4.7-4.6 1.2M26.4 17.1l-4.6-1.2 1.2-4.7" />
      <path d="M5 28l6.8-8 3.4 3.4 3.7-5.1L27 28" />
    </>
  )}
  {realm === 'lantern-lane' && (
    <>
      <path d="M10 9.5c1.5-2.9 3.5-4.8 6-5.9 2.5 1.1 4.5 3 6 5.9M8 10h16l-1.5 13h-13L8 10Z" />
      <path d="M12 14.5c2.7 1.4 5.3 1.4 8 0M13 23v3.5m6-3.5v3.5M11 27h10" />
      <path d="M16 10c-2 3-2 6 0 9 2-3 2-6 0-9Z" />
    </>
  )}
</svg>

<style>
  .oracle-sigil {
    display: block;
    flex: 0 0 auto;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
</style>
