<section class="focus-timer" id="focus" aria-labelledby="focus-timer-title" data-focus-timer data-pagefind-ignore>
  <header class="section-heading"><p class="pixel-kicker">STAR ABYSS · 专注</p><h2 id="focus-timer-title">把目光，留给此刻。</h2><p>离开页面也会按真实时间继续计算；完成一程后，将记录在今日星轨中。</p></header>
  <div class="focus-timer__panel pixel-frame">
    <div class="focus-timer__clock"><span data-focus-mode>专注</span><strong data-focus-clock>25:00</strong><p data-focus-summary>今日完成 0 程 · 0 分钟</p></div>
    <div class="focus-timer__controls"><label>这一程要做什么<input data-focus-title maxlength="100" placeholder="例如：整理一节学习笔记" /></label><div><button type="button" data-focus-preset="25">25 分钟</button><button type="button" data-focus-preset="50">50 分钟</button><button type="button" data-focus-preset="5">休息 5 分钟</button></div><footer><button class="pixel-button pixel-button--primary" type="button" data-focus-toggle>开始</button><button class="pixel-button" type="button" data-focus-reset>重置</button><button class="pixel-button" type="button" data-focus-notify>开启完成提醒</button></footer></div>
  </div>
</section>

<script>
  import { LIFE_KEYS, LIFE_UPDATED_EVENT, announceLifeUpdate, lifeId, localDateKey, readStored, writeStored } from '../utils/lifeStore';
  const root=document.querySelector<HTMLElement>('[data-focus-timer]');
  if(root){
    const STATE='yuncun-life-focus-state-v1'; let timer:number|undefined;
    type State={minutes:number;remaining:number;endsAt:number|null;running:boolean;title:string};
    const read=()=>readStored<State>(localStorage,STATE,{minutes:25,remaining:1500,endsAt:null,running:false,title:''}); const save=(state:State)=>writeStored(localStorage,STATE,state);
    const clock=root.querySelector<HTMLElement>('[data-focus-clock]'); const toggle=root.querySelector<HTMLButtonElement>('[data-focus-toggle]'); const title=root.querySelector<HTMLInputElement>('[data-focus-title]');
    const complete=(state:State)=>{ const log=readStored<any[]>(localStorage,LIFE_KEYS.focusLog,[]); log.push({id:lifeId('focus'),title:state.title||'未命名专注',minutes:state.minutes,date:localDateKey(),completedAt:new Date().toISOString()}); writeStored(localStorage,LIFE_KEYS.focusLog,log); state.running=false;state.endsAt=null;state.remaining=state.minutes*60;save(state);announceLifeUpdate('focus'); if('Notification' in window && Notification.permission==='granted')new Notification('这一程完成了',{body:state.title||`已专注 ${state.minutes} 分钟`}); };
    const render=()=>{ let state=read(); if(state.running&&state.endsAt){state.remaining=Math.max(0,Math.ceil((state.endsAt-Date.now())/1000));if(state.remaining<=0)complete(state);else save(state);} const m=Math.floor(state.remaining/60);const s=state.remaining%60;if(clock)clock.textContent=`${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;if(toggle)toggle.textContent=state.running?'暂停':'开始';if(title&&document.activeElement!==title)title.value=state.title; const log=readStored<any[]>(localStorage,LIFE_KEYS.focusLog,[]).filter((item)=>item.date===localDateKey()); const summary=root.querySelector('[data-focus-summary]');if(summary)summary.textContent=`今日完成 ${log.length} 程 · ${log.reduce((sum,item)=>sum+Number(item.minutes||0),0)} 分钟`;};
    const schedule=()=>{window.clearInterval(timer);timer=window.setInterval(render,1000);render();};
    root.querySelectorAll<HTMLButtonElement>('[data-focus-preset]').forEach((button)=>button.addEventListener('click',()=>{const minutes=Number(button.dataset.focusPreset);const state=read();Object.assign(state,{minutes,remaining:minutes*60,endsAt:null,running:false});save(state);render();}));
    toggle?.addEventListener('click',()=>{const state=read();state.title=title?.value.trim()||state.title;if(state.running){state.remaining=Math.max(0,Math.ceil(((state.endsAt||Date.now())-Date.now())/1000));state.running=false;state.endsAt=null;}else{state.running=true;state.endsAt=Date.now()+state.remaining*1000;}save(state);schedule();});
    title?.addEventListener('change',()=>{const state=read();state.title=title.value.trim();save(state);});
    root.querySelector('[data-focus-reset]')?.addEventListener('click',()=>{const state=read();Object.assign(state,{remaining:state.minutes*60,endsAt:null,running:false});save(state);render();});
    root.querySelector('[data-focus-notify]')?.addEventListener('click',async()=>{if('Notification'in window)await Notification.requestPermission();});
    schedule();window.addEventListener(LIFE_UPDATED_EVENT,render);
  }
</script>

<style>
  .focus-timer { margin-top:72px; }
  .focus-timer>.section-heading { max-width:820px; padding:26px; border-left:5px solid #9d8bd9; color:#ccd7ea; background:rgba(12,22,43,.84); }
  .focus-timer>.section-heading h2 { color:#f3edcf; }
  .focus-timer__panel { display:grid; grid-template-columns:.72fr 1.28fr; gap:28px; margin-top:20px; padding:clamp(20px,4vw,34px); border-color:#697399; color:#d9e4f6; background:linear-gradient(140deg,#172448,#111b36); }
  .focus-timer__clock { display:grid; place-items:center; align-content:center; padding:24px; border:2px solid #7480a7; background:#0c1630; text-align:center; }
  .focus-timer__clock span,.focus-timer__clock p { color:#9eadd0; font-size:.7rem; }
  .focus-timer__clock strong { color:#efd87f; font-family:monospace; font-size:clamp(3.2rem,8vw,5.4rem); line-height:1.1; }
  .focus-timer__controls { display:grid; align-content:center; gap:18px; }
  .focus-timer__controls label { display:grid; gap:7px; font-size:.72rem; font-weight:900; }
  .focus-timer__controls input { min-height:46px; padding:10px 12px; border:2px solid #7783aa; color:#edf2ff; background:#111c38; font:inherit; }
  .focus-timer__controls>div,.focus-timer__controls footer { display:flex; flex-wrap:wrap; gap:8px; }
  .focus-timer__controls>div button { padding:8px 11px; border:2px solid #7380a7; color:#dce6fa; background:#253457; cursor:pointer; }
  @media(max-width:720px){.focus-timer__panel{grid-template-columns:1fr}.focus-timer__clock strong{font-size:3.8rem}}
</style>
