<div class="home-geometry-field" data-home-geometry aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  interface GeometryNode {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    angle: number;
    spin: number;
    phase: number;
    shape: 'dot' | 'diamond' | 'triangle';
  }

  interface Palette {
    dot: string;
    bright: string;
    line: string;
    pointer: string;
    halo: string;
  }

  const palettes: Record<string, Palette> = {
    dawn: {
      dot: 'rgba(255, 239, 207, .86)',
      bright: 'rgba(169, 232, 226, .9)',
      line: 'rgba(112, 188, 194, .64)',
      pointer: 'rgba(255, 213, 145, .78)',
      halo: 'rgba(255, 215, 158, .18)',
    },
    day: {
      dot: 'rgba(39, 126, 146, .76)',
      bright: 'rgba(255, 228, 157, .82)',
      line: 'rgba(39, 131, 151, .54)',
      pointer: 'rgba(255, 204, 105, .72)',
      halo: 'rgba(255, 214, 127, .16)',
    },
    dusk: {
      dot: 'rgba(250, 187, 151, .84)',
      bright: 'rgba(194, 190, 255, .9)',
      line: 'rgba(218, 158, 181, .64)',
      pointer: 'rgba(255, 211, 145, .8)',
      halo: 'rgba(244, 176, 190, .2)',
    },
    night: {
      dot: 'rgba(145, 220, 239, .9)',
      bright: 'rgba(213, 228, 255, .94)',
      line: 'rgba(110, 174, 222, .7)',
      pointer: 'rgba(185, 230, 255, .9)',
      halo: 'rgba(126, 191, 255, .2)',
    },
  };

  document.querySelectorAll<HTMLElement>('[data-home-geometry]').forEach((host) => {
    if (host.dataset.ready === 'true') return;
    host.dataset.ready = 'true';

    const canvas = host.querySelector('canvas');
    const scene = host.closest<HTMLElement>('.home-after-map');
    const context = canvas?.getContext('2d');
    if (!canvas || !scene || !context) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    const device = navigator as Navigator & {
      deviceMemory?: number;
      connection?: { saveData?: boolean; effectiveType?: string };
    };
    const constrainedNetwork = Boolean(device.connection?.saveData || /(^|-)2g$/.test(device.connection?.effectiveType || ''));
    const lowPower = (navigator.hardwareConcurrency || 8) < 6 || (device.deviceMemory || 8) < 4;
    const pointer = { x: 0, y: 0, active: false };
    let nodes: GeometryNode[] = [];
    let width = 0;
    let height = 0;
    let ratio = 1;
    let running = false;
    let visible = false;
    let frame = 0;
    let lastFrame = 0;
    let resizeFrame = 0;
    let palette = palettes.day;

    const currentPalette = () => {
      const time = document.documentElement.dataset.time || 'day';
      palette = palettes[time] || palettes.day;
    };

    const makeNode = (): GeometryNode => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - .5) * .28,
      vy: (Math.random() - .5) * .24,
      radius: .85 + Math.random() * 1.75,
      angle: Math.random() * Math.PI,
      spin: (Math.random() - .5) * .003,
      phase: Math.random() * Math.PI * 2,
      shape: Math.random() > .9 ? 'triangle' : Math.random() > .78 ? 'diamond' : 'dot',
    });

    const resize = () => {
      const rect = scene.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(window.innerHeight));
      ratio = Math.min(window.devicePixelRatio || 1, finePointer && !lowPower ? 1.5 : 1);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      const constrainedDevice = lowPower || constrainedNetwork;
      const areaCount = Math.round((width * height) / (finePointer ? 6_500 : 9_000));
      const minimum = finePointer ? (constrainedDevice ? 72 : 135) : 32;
      const maximum = constrainedDevice ? (finePointer ? 96 : 42) : (finePointer ? 190 : 68);
      const staticCount = finePointer ? 42 : 24;
      const count = reducedMotion ? Math.min(staticCount, maximum) : Math.max(minimum, Math.min(maximum, areaCount));
      nodes = Array.from({ length: count }, makeNode);
      host.dataset.nodeCount = String(count);
      draw(performance.now(), false);
    };

    const drawNode = (node: GeometryNode, index: number, now: number) => {
      const pulse = 1 + Math.sin(now * .0012 + node.phase) * .22;
      const radius = node.radius * pulse;
      context.save();
      context.translate(node.x, node.y);
      context.rotate(node.angle);
      context.fillStyle = index % 7 === 0 ? palette.bright : palette.dot;
      context.strokeStyle = index % 5 === 0 ? palette.bright : palette.dot;
      if (node.shape === 'dot') {
        context.beginPath();
        context.arc(0, 0, radius, 0, Math.PI * 2);
        context.fill();
      } else if (node.shape === 'diamond') {
        const size = radius * 3.2;
        context.lineWidth = .8;
        context.strokeRect(-size / 2, -size / 2, size, size);
      } else {
        const size = radius * 3.8;
        context.lineWidth = .8;
        context.beginPath();
        context.moveTo(0, -size * .58);
        context.lineTo(size * .54, size * .4);
        context.lineTo(-size * .54, size * .4);
        context.closePath();
        context.stroke();
      }
      context.restore();
    };

    const draw = (now: number, update = true) => {
      context.clearRect(0, 0, width, height);
      const connection = Math.min(142, Math.max(98, width * .086));
      const connectionSquared = connection * connection;

      if (update) {
        nodes.forEach((node) => {
          if (pointer.active) {
            const dx = pointer.x - node.x;
            const dy = pointer.y - node.y;
            const distanceSquared = dx * dx + dy * dy;
            if (distanceSquared > 64 && distanceSquared < 67_600) {
              const force = 1 - Math.sqrt(distanceSquared) / 260;
              node.vx += dx * force * .000018;
              node.vy += dy * force * .000018;
            }
          }
          node.vx *= .999;
          node.vy *= .999;
          const speed = Math.hypot(node.vx, node.vy);
          if (speed > .58) { node.vx *= .58 / speed; node.vy *= .58 / speed; }
          node.x += node.vx;
          node.y += node.vy;
          node.angle += node.spin;
          if (node.x < 0 || node.x > width) {
            node.vx *= -1;
            node.x = Math.max(0, Math.min(width, node.x));
          }
          if (node.y < 0 || node.y > height) {
            node.vy *= -1;
            node.y = Math.max(0, Math.min(height, node.y));
          }
        });
      }

      context.lineWidth = .72;
      for (let left = 0; left < nodes.length; left += 1) {
        const a = nodes[left];
        for (let right = left + 1; right < nodes.length; right += 1) {
          const b = nodes[right];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const distanceSquared = dx * dx + dy * dy;
          if (distanceSquared >= connectionSquared) continue;
          const alpha = (1 - distanceSquared / connectionSquared) * .78;
          context.globalAlpha = alpha;
          context.strokeStyle = palette.line;
          context.beginPath();
          context.moveTo(a.x, a.y);
          context.lineTo(b.x, b.y);
          context.stroke();
        }
      }

      if (pointer.active) {
        const halo = context.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, 92);
        halo.addColorStop(0, palette.halo);
        halo.addColorStop(1, 'rgba(255,255,255,0)');
        context.globalAlpha = 1;
        context.fillStyle = halo;
        context.beginPath();
        context.arc(pointer.x, pointer.y, 92, 0, Math.PI * 2);
        context.fill();
        nodes.forEach((node) => {
          const dx = pointer.x - node.x;
          const dy = pointer.y - node.y;
          const distance = Math.hypot(dx, dy);
          if (distance >= 260) return;
          context.globalAlpha = (1 - distance / 260) * .92;
          context.strokeStyle = palette.pointer;
          context.lineWidth = 1.15;
          context.beginPath();
          context.moveTo(pointer.x, pointer.y);
          context.lineTo(node.x, node.y);
          context.stroke();
        });
        context.globalAlpha = .88;
        context.strokeStyle = palette.pointer;
        context.lineWidth = 1;
        context.beginPath();
        context.arc(pointer.x, pointer.y, 3.5, 0, Math.PI * 2);
        context.stroke();
      }

      context.globalAlpha = 1;
      nodes.forEach((node, index) => drawNode(node, index, now));
    };

    const animate = (now: number) => {
      if (!running) return;
      const interval = finePointer && !lowPower ? 1000 / 40 : 1000 / 24;
      if (now - lastFrame >= interval) {
        lastFrame = now;
        draw(now);
      }
      frame = window.requestAnimationFrame(animate);
    };

    const start = () => {
      if (running || reducedMotion || !visible || document.hidden) return;
      running = true;
      host.dataset.motion = 'active';
      frame = window.requestAnimationFrame(animate);
    };

    const stop = () => {
      running = false;
      host.dataset.motion = reducedMotion ? 'static' : 'paused';
      window.cancelAnimationFrame(frame);
    };

    const setPointer = (event: PointerEvent) => {
      if (!finePointer) return;
      const rect = canvas.getBoundingClientRect();
      pointer.x = event.clientX - rect.left;
      pointer.y = event.clientY - rect.top;
      pointer.active = pointer.x >= 0 && pointer.x <= rect.width && pointer.y >= 0 && pointer.y <= rect.height;
    };

    const scheduleResize = () => {
      window.cancelAnimationFrame(resizeFrame);
      resizeFrame = window.requestAnimationFrame(resize);
    };

    currentPalette();
    resize();
    scene.addEventListener('pointermove', setPointer, { passive: true });
    scene.addEventListener('pointerleave', () => { pointer.active = false; });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    window.addEventListener('resize', scheduleResize, { passive: true });

    const resizeObserver = new ResizeObserver(scheduleResize);
    resizeObserver.observe(scene);

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start(); else stop();
    }, { rootMargin: '160px 0px' });
    intersectionObserver.observe(scene);

    const timeObserver = new MutationObserver(() => {
      currentPalette();
      if (!running) draw(performance.now(), false);
    });
    timeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-time'] });
    if (reducedMotion) host.dataset.motion = 'static';
  });
</script>

<style>
  .home-geometry-field {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: .92;
    contain: paint;
  }

  canvas {
    position: sticky;
    top: 0;
    display: block;
    width: 100%;
    height: 100svh;
  }

  :global(html[data-time='day']) .home-geometry-field {
    mix-blend-mode: multiply;
    opacity: .72;
  }

  @media (max-width: 760px) {
    .home-geometry-field { opacity: .5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-geometry-field { opacity: .32; }
  }
</style>
