---
import '../styles/global.css';
interface Props { title?: string; description?: string; publicOrigin?: string }
const {
  title = '私人工作台',
  description = '闲梦world 唯一管理员私人工作台',
  publicOrigin = 'https://xianmeng-yuncun.pages.dev',
} = Astro.props;
const backgroundUrl = `${publicOrigin.replace(/\/$/, '')}/images/backgrounds/workspace-starriver-v6-1536.webp`;
---
<style is:global>
  body {
    background-image: linear-gradient(180deg, rgba(5, 28, 45, .72), rgba(10, 46, 57, .88)), var(--workspace-background);
    background-position: center;
    background-size: cover;
    background-attachment: fixed;
  }
</style>
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#15384a" />
    <title>{title}｜闲梦world</title>
  </head>
  <body style={`--workspace-background: url("${backgroundUrl}")`}>
    <a class="skip-link" href="#admin-main">跳到私人工作台</a>
    <main id="admin-main"><slot /></main>
  </body>
</html>
