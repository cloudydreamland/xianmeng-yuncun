# Public origin used by the one-time cross-origin migration bridge.
PUBLIC_SITE_ORIGIN=https://xianmeng-yuncun.pages.dev
PUBLIC_ADMIN_ORIGIN=https://xianmeng-yuncun-admin.pages.dev

# Cloudflare Pages Function secrets/variables. Never commit real values.
# Required exact numeric QQ email allowlist for password login (not display only).
ADMIN_EMAIL=
# SHA-256 base64url of a random 32-byte setup token. Not a password.
# Remove after the first passkey is enrolled. Never enable open registration.
ADMIN_SETUP_TOKEN_HASH=

# Bind the administrator D1 database with the exact binding name DB.
