# Optional: enable R2 + Cloudflare Images delivery after binding an image domain.
# Example: https://img.example.com
PUBLIC_MEDIA_ORIGIN=

# Zone where Cloudflare Images transformations are enabled.
# Example: https://example.com
PUBLIC_IMAGE_TRANSFORM_ORIGIN=

# Canonical public website URL.
PUBLIC_SITE_URL=https://xianmeng-yuncun.pages.dev

# Cloudflare Pages Function private sync (server-side bindings/variables).
# Protect /api/sync with a Cloudflare Access application before enabling these.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=
SYNC_ALLOWED_EMAIL=

# Bind a D1 database in the Pages dashboard with the exact name YUNCUN_DB.
